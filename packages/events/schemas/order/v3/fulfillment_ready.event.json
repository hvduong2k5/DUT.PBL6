{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.omama.example/order/v3/fulfillment_ready.event.json",
  "title": "Order fulfillment_ready v3 — proposed 3.2 design",
  "description": "Proposed contract; deploy consumers before enabling the new cohort. No v1/v2 effect triggers for this cohort. Partition key=aggregate_id; subject must equal order:<aggregate_id>. Version/ordinal order local facts, not distributed effects.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "subject",
    "time",
    "datacontenttype",
    "data"
  ],
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "const": "https://omama.vn/services/order-service"
    },
    "type": {
      "const": "vn.omama.order.fulfillment_ready.v3"
    },
    "subject": {
      "type": "string",
      "pattern": "^order:[0-9a-f-]{36}$"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "traceparent": {
      "type": "string",
      "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"
    },
    "tracestate": {
      "type": "string",
      "maxLength": 512
    },
    "correlationid": {
      "type": "string",
      "maxLength": 128
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aggregate_id",
        "version",
        "ordinal",
        "status",
        "payment_status",
        "stock_status",
        "items_digest",
        "warehouse_id",
        "reservation_id",
        "stock_resource_version",
        "ready_generation",
        "policy_version"
      ],
      "properties": {
        "aggregate_id": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "integer",
          "format": "int64",
          "minimum": 1
        },
        "ordinal": {
          "type": "integer",
          "format": "int64",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "PAID",
            "CONFIRMED_COD"
          ]
        },
        "payment_status": {
          "type": "string",
          "enum": [
            "UNPAID",
            "PENDING",
            "CONFIRMED",
            "RECONCILIATION_REQUIRED",
            "PARTIALLY_REFUNDED",
            "REFUNDED"
          ]
        },
        "stock_status": {
          "const": "COMMITTED"
        },
        "items_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "warehouse_id": {
          "type": "string",
          "minLength": 1
        },
        "reservation_id": {
          "type": "string",
          "format": "uuid"
        },
        "stock_resource_version": {
          "type": "integer",
          "format": "int64",
          "minimum": 1
        },
        "ready_generation": {
          "type": "integer",
          "format": "int64",
          "minimum": 1
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "properties": {
            "status": {
              "const": "PAID"
            },
            "payment_status": {
              "const": "CONFIRMED"
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": "CONFIRMED_COD"
            },
            "payment_status": {
              "const": "UNPAID"
            },
            "stock_status": {
              "const": "COMMITTED"
            }
          }
        }
      ]
    }
  }
}
