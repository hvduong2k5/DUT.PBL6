{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Order cancelled v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "subject",
    "time",
    "datacontenttype",
    "data"
  ],
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "type": "string"
    },
    "type": {
      "const": "vn.omama.order.cancelled.v2"
    },
    "subject": {
      "type": "string"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aggregate_id",
        "version",
        "status"
      ],
      "properties": {
        "aggregate_id": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "type": "string"
        },
        "payment_status": {
          "type": "string"
        },
        "stock_status": {
          "type": "string"
        },
        "ready_generation": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
