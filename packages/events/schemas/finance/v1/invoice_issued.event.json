{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InvoiceIssuedEvent",
  "description": "Sự kiện phát ra khi MS-09 Finance Service xuất thành công hóa đơn điện tử VAT cho đơn hàng kẹo mè xửng. Topic: finance.events.v1. Partition Key: order_id",
  "type": "object",
  "required": ["specversion", "id", "source", "type", "subject", "time", "datacontenttype", "traceparent", "data"],
  "properties": {
    "specversion": { "type": "string", "enum": ["1.0"] },
    "id": { "type": "string" },
    "source": { "type": "string", "format": "uri", "example": "https://omama.vn/services/finance-service" },
    "type": { "type": "string", "enum": ["vn.omama.finance.invoice.issued.v1"] },
    "subject": { "type": "string", "example": "order_id:ORD-20261015-0042" },
    "time": { "type": "string", "format": "date-time" },
    "datacontenttype": { "type": "string", "enum": ["application/json"] },
    "traceparent": { "type": "string" },
    "data": {
      "type": "object",
      "required": ["invoice_id", "invoice_number", "order_id", "customer_id", "total_amount", "vat_amount", "invoice_pdf_url", "issued_at"],
      "properties": {
        "invoice_id": { "type": "string" },
        "invoice_number": { "type": "string", "example": "HD-OMA-2026-001248" },
        "order_id": { "type": "string" },
        "customer_id": { "type": "string" },
        "tax_code": { "type": "string", "description": "Mã số thuế doanh nghiệp (nếu có)" },
        "company_name": { "type": "string" },
        "total_amount": {
          "type": "object",
          "required": ["currency_code", "units", "nanos"],
          "properties": {
            "currency_code": { "type": "string" },
            "units": { "type": "integer" },
            "nanos": { "type": "integer" }
          }
        },
        "vat_amount": {
          "type": "object",
          "required": ["currency_code", "units", "nanos"],
          "properties": {
            "currency_code": { "type": "string" },
            "units": { "type": "integer" },
            "nanos": { "type": "integer" }
          }
        },
        "invoice_pdf_url": { "type": "string", "format": "uri" },
        "issued_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
