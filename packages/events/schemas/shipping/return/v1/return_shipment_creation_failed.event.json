{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReturnShipmentCreationFailedEventV1",
  "description": "The carrier rejected or failed to create a customer-to-warehouse return pickup after Care approved the case. Topic shipping.return.events.v1; partition key return_shipment_id. This event is not a refund result.",
  "type": "object",
  "additionalProperties": false,
  "required": ["specversion", "id", "source", "type", "subject", "time", "datacontenttype", "traceparent", "data"],
  "properties": {
    "specversion": { "type": "string", "const": "1.0" },
    "id": { "type": "string", "format": "uuid" },
    "source": { "type": "string", "format": "uri" },
    "type": { "type": "string", "const": "vn.omama.shipping.return-shipment.creation-failed.v1" },
    "subject": { "type": "string", "pattern": "^return_shipment_id:.+" },
    "time": { "type": "string", "format": "date-time" },
    "datacontenttype": { "type": "string", "const": "application/json" },
    "traceparent": { "type": "string", "pattern": "^00-[a-f0-9]{32}-[a-f0-9]{16}-[a-f0-9]{2}$" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["return_shipment_id", "return_case_id", "order_id", "package_id", "carrier_code", "status", "fee_payer", "cod_amount_vnd", "resource_version"],
      "properties": {
        "return_shipment_id": { "type": "string", "format": "uuid" },
        "return_case_id": { "type": "string", "minLength": 1 },
        "order_id": { "type": "string", "minLength": 1 },
        "package_id": { "type": "string", "minLength": 1 },
        "carrier_code": { "type": "string", "minLength": 1 },
        "tracking_code": { "type": "string" },
        "status": { "type": "string", "const": "CREATION_FAILED" },
        "fee_payer": { "type": "string", "const": "SHOP" },
        "cod_amount_vnd": { "type": "integer", "const": 0 },
        "resource_version": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
