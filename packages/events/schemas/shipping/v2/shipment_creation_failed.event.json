{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ShipmentCreationFailedEventV2",
  "description": "MVP integration target. Topic shipping.events.v2; key shipment_id. v1 unchanged.",
  "type": "object",
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "subject",
    "time",
    "datacontenttype",
    "traceparent",
    "data"
  ],
  "properties": {
    "specversion": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "type": "string",
      "format": "uri"
    },
    "type": {
      "type": "string",
      "enum": [
        "vn.omama.shipping.shipment.creation-failed.v2"
      ]
    },
    "subject": {
      "type": "string"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "datacontenttype": {
      "type": "string",
      "enum": [
        "application/json"
      ]
    },
    "traceparent": {
      "type": "string",
      "pattern": "^00-[a-f0-9]{32}-[a-f0-9]{16}-[a-f0-9]{2}$"
    },
    "data": {
      "$ref": "#/definitions/shipmentData"
    }
  },
  "definitions": {
    "shipmentData": {
      "type": "object",
      "required": [
        "shipment_id",
        "order_id",
        "package_id",
        "carrier_code",
        "status",
        "resource_version",
        "ready_generation"
      ],
      "properties": {
        "shipment_id": {
          "type": "string",
          "format": "uuid"
        },
        "order_id": {
          "type": "string",
          "minLength": 1
        },
        "package_id": {
          "type": "string",
          "minLength": 1
        },
        "carrier_code": {
          "type": "string",
          "minLength": 1
        },
        "tracking_code": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "CREATION_FAILED"
          ]
        },
        "resource_version": {
          "type": "integer",
          "minimum": 1
        },
        "ready_generation": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
