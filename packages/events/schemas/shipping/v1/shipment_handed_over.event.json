{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ShipmentHandedOverEvent",
  "description": "Kiện hàng đã thực sự được bàn giao cho carrier; Order có thể xem xét chuyển SHIPPED. Topic: shipping.events.v1. Partition Key: shipment_id",
  "type": "object",
  "required": ["specversion", "id", "source", "type", "subject", "time", "datacontenttype", "traceparent", "data"],
  "properties": {
    "specversion": { "type": "string", "enum": ["1.0"] },
    "id": { "type": "string", "format": "uuid" },
    "source": { "type": "string", "format": "uri" },
    "type": { "type": "string", "enum": ["vn.omama.shipping.shipment.handed-over.v1"] },
    "subject": { "type": "string" },
    "time": { "type": "string", "format": "date-time" },
    "datacontenttype": { "type": "string", "enum": ["application/json"] },
    "traceparent": { "type": "string", "pattern": "^00-[a-f0-9]{32}-[a-f0-9]{16}-[a-f0-9]{2}$" },
    "data": { "$ref": "#/definitions/shipmentData" }
  },
  "definitions": {
    "shipmentData": {
      "type": "object",
      "required": ["shipment_id", "order_id", "package_id", "carrier_code", "tracking_code", "status"],
      "properties": {
        "shipment_id": { "type": "string", "format": "uuid" },
        "order_id": { "type": "string", "minLength": 1 },
        "package_id": { "type": "string", "minLength": 1 },
        "carrier_code": { "type": "string", "minLength": 1 },
        "tracking_code": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["HANDED_OVER"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
