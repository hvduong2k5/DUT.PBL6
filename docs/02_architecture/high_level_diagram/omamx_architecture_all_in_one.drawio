    <mxCell id="m9" value="9a. ReserveStock(order_id, items, ttl=15m)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;fontColor=#000000;strokeColor=#0066cc;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.520;entryX=0.5;entryY=0.520;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_order" target="ll_inv" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell>
