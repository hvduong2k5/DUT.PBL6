    <mxCell id="sc_eng" value="&lt;b&gt;Phân Hệ Chuỗi Cung Ứng &amp; Kho Vận&lt;/b&gt;&lt;br&gt;&lt;font style=&apos;font-size:10px&apos;&gt;[Software System]&lt;/font&gt;&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;Quản lý tồn kho đa kho FEFO, điều phối nhặt hàng,&lt;br&gt;ghi nhận video seal, tạo vận đơn&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="eb_sc"><mxGeometry x="40" y="45" width="640" height="95" as="geometry"/></mxCell>
    <mxCell id="coop_hue" value="&lt;b&gt;Hợp Tác Xã Nông Nghiệp&lt;/b&gt;&lt;br&gt;&lt;font style=&apos;font-size:10px&apos;&gt;[External System]&lt;/font&gt;&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;Vùng trồng mè đen, đậu phụng, đường phèn&lt;br&gt;OCOP đạt chuẩn VietGAP&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8C8C8C;fontColor=#ffffff;fontSize=11;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="30" y="570" width="240" height="100" as="geometry"/></mxCell>
    <mxCell id="logistics_3pl" value="&lt;b&gt;Hãng Vận Chuyển 3PL&lt;/b&gt;&lt;br&gt;&lt;font style=&apos;font-size:10px&apos;&gt;[External System]&lt;/font&gt;&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;GHN / ViettelPost tiếp nhận thùng kẹo,&lt;br&gt;vận chuyển liên tỉnh chặng cuối&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8C8C8C;fontColor=#ffffff;fontSize=11;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="300" y="570" width="240" height="100" as="geometry"/></mxCell>
    <mxCell id="aws_s3" value="&lt;b&gt;AWS S3 Object Storage&lt;/b&gt;&lt;br&gt;&lt;font style=&apos;font-size:10px&apos;&gt;[External System]&lt;/font&gt;&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;Lưu trữ video đóng gói có seal (WORM),&lt;br&gt;cấp Pre-signed URL TTL 15m&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8C8C8C;fontColor=#ffffff;fontSize=11;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="570" y="570" width="240" height="100" as="geometry"/></mxCell>
    <mxCell id="audit_worm" value="&lt;b&gt;AWS S3 WORM Lock&lt;/b&gt;&lt;br&gt;&lt;font style=&apos;font-size:10px&apos;&gt;[External System]&lt;/font&gt;&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;Lưu trữ checkpoint Merkle Tree&lt;br&gt;kiểm toán pháp lý định kỳ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8C8C8C;fontColor=#ffffff;fontSize=11;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="840" y="570" width="240" height="100" as="geometry"/></mxCell>
    <mxCell id="e_sp" value="&lt;b&gt;Nhận picking task, quay video seal&lt;/b&gt;&lt;br&gt;&lt;font style=&apos;font-size:8px;color:#555555&apos;&gt;[HTTPS / Tablet App]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#000000;strokeColor=#444444;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;" edge="1" source="staff_pack" target="eb_sc" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="e_sw" value="&lt;b&gt;Kiểm kê kho, lập phiếu nhập, xuất 3PL&lt;/b&gt;&lt;br&gt;&lt;font style=&apos;font-size:8px;color:#555555&apos;&gt;[HTTPS / Web Admin]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#000000;strokeColor=#444444;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="staff_wh" target="eb_sc" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="e_sc" value="&lt;b&gt;Tra cứu video theo mã seal kiện&lt;/b&gt;&lt;br&gt;&lt;font style=&apos;font-size:8px;color:#555555&apos;&gt;[HTTPS / Web Admin]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#000000;strokeColor=#444444;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" edge="1" source="staff_cs" target="eb_sc" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="e_coop" value="&lt;b&gt;Giao mè/đậu kèm chứng từ OCOP&lt;/b&gt;&lt;br&gt;&lt;font style=&apos;font-size:8px;color:#555555&apos;&gt;[Biên bản nhập kho]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#000000;strokeColor=#444444;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.12;entryY=1;entryDx=0;entryDy=0;" edge="1" source="coop_hue" target="eb_sc" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="e_3pl_out" value="&lt;b&gt;Gọi Open API tạo vận đơn&lt;/b&gt;&lt;br&gt;&lt;font style=&apos;font-size:8px;color:#555555&apos;&gt;[REST API HTTPS]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#000000;strokeColor=#444444;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.32;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" source="eb_sc" target="logistics_3pl" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="-30" y="0" as="offset"/></mxGeometry></mxCell>
    <mxCell id="e_3pl_in" value="&lt;b&gt;Cập nhật tọa độ &amp; trạng thái&lt;/b&gt;&lt;br&gt;&lt;font style=&apos;font-size:8px;color:#555555&apos;&gt;[HTTPS Webhook]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#000000;strokeColor=#444444;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.48;entryY=1;entryDx=0;entryDy=0;" edge="1" source="logistics_3pl" target="eb_sc" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="30" y="0" as="offset"/></mxGeometry></mxCell>
    <mxCell id="e_s3" value="&lt;b&gt;Upload video seal (SHA-256)&lt;/b&gt;&lt;br&gt;&lt;font style=&apos;font-size:8px;color:#555555&apos;&gt;[AWS S3 SDK (TLS 1.3)]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#000000;strokeColor=#444444;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.68;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="eb_sc" target="aws_s3" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
