  <diagram id="tab_8" name="3.1 Checkout Sequence">
    <mxGraphModel dx="1380" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1380" pageHeight="760" math="0" shadow="0">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="ll_cust" value="&lt;b&gt;Khách Hàng (D2C)&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;fontSize=10;fontStyle=1;size=35;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="150" height="660" as="geometry"/></mxCell>
    <mxCell id="ll_gw" value="&lt;b&gt;API Gateway (Kong)&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#e65100;strokeColor=#bf360c;fontColor=#ffffff;fontSize=10;fontStyle=1;size=35;" vertex="1" parent="1"><mxGeometry x="250" y="70" width="160" height="660" as="geometry"/></mxCell>
    <mxCell id="ll_order" value="&lt;b&gt;MS-04: Order Saga&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#0066cc;strokeColor=#004c99;fontColor=#ffffff;fontSize=10;fontStyle=1;size=35;" vertex="1" parent="1"><mxGeometry x="480" y="70" width="170" height="660" as="geometry"/></mxCell>
    <mxCell id="ll_inv" value="&lt;b&gt;MS-01: Inventory&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#2e7d32;strokeColor=#1b5e20;fontColor=#ffffff;fontSize=10;fontStyle=1;size=35;" vertex="1" parent="1"><mxGeometry x="720" y="70" width="150" height="660" as="geometry"/></mxCell>
    <mxCell id="ll_cat" value="&lt;b&gt;MS-05: Catalog&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#2e7d32;strokeColor=#1b5e20;fontColor=#ffffff;fontSize=10;fontStyle=1;size=35;" vertex="1" parent="1"><mxGeometry x="930" y="70" width="150" height="660" as="geometry"/></mxCell>
    <mxCell id="ll_prm" value="&lt;b&gt;MS-07: Promotion&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#2e7d32;strokeColor=#1b5e20;fontColor=#ffffff;fontSize=10;fontStyle=1;size=35;" vertex="1" parent="1"><mxGeometry x="1140" y="70" width="150" height="660" as="geometry"/></mxCell>
    <mxCell id="m1" value="1. POST /api/v1/checkout (JWT, Cart, Address)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;fontColor=#000000;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.090;entryX=0.5;entryY=0.090;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_cust" target="ll_gw" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell>
    <mxCell id="m2" value="2. Validate JWT (Cached JWKS 0.05ms)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;fontColor=#000000;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.140;entryX=0.5;entryY=0.140;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_gw" target="ll_gw" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell>
    <mxCell id="m3" value="3. Forward Request + X-User-Id + traceparent" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;fontColor=#000000;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.190;entryX=0.5;entryY=0.190;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_gw" target="ll_order" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell>
    <mxCell id="m4" value="4. Local DB Tx: Tạo Order DRAFT + Saga IN_PROGRESS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;fontColor=#000000;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.250;entryX=0.5;entryY=0.250;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_order" target="ll_order" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell>
    <mxCell id="par1" value="par Thẩm Tra Đồng Thời Qua gRPC (Critical Path Timeout 2.0s)" style="swimlane;startSize=22;fillColor=#f0f7ff;strokeColor=#6c8ebf;dashed=1;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="450" y="245" width="870" height="265" as="geometry"/></mxCell>
    <mxCell id="m5" value="5. ReserveStock(order_id, items, ttl=15m)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;fontColor=#000000;strokeColor=#0066cc;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.350;entryX=0.5;entryY=0.350;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_order" target="ll_inv" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell>
    <mxCell id="m6" value="6. DB Tx (SELECT FOR UPDATE): Khóa tồn 15m" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;fontColor=#000000;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.400;entryX=0.5;entryY=0.400;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_inv" target="ll_inv" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell>
    <mxCell id="m7" value="7. Response: RESERVATION_STATUS_SUCCESS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;fontColor=#000000;strokeColor=#0066cc;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;exitX=0.5;exitY=0.450;entryX=0.5;entryY=0.450;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_inv" target="ll_order" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell>
    <mxCell id="m8" value="8. ValidatePriceAndSKU(items)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;fontColor=#000000;strokeColor=#0066cc;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.520;entryX=0.5;entryY=0.520;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_order" target="ll_cat" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell>
    <mxCell id="m9" value="9. Response: VALID (Đúng giá niêm yết OCOP)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;fontColor=#000000;strokeColor=#0066cc;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;exitX=0.5;exitY=0.570;entryX=0.5;entryY=0.570;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_cat" target="ll_order" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell>
    <mxCell id="m10" value="10. ValidateVoucher(voucher_code, user_id)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;fontColor=#000000;strokeColor=#0066cc;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.640;entryX=0.5;entryY=0.640;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_order" target="ll_prm" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell>
    <mxCell id="m11" value="11. Response: VALID (Đủ điều kiện giảm 10%)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;fontColor=#000000;strokeColor=#0066cc;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;exitX=0.5;exitY=0.690;entryX=0.5;entryY=0.690;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_prm" target="ll_order" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell>
    <mxCell id="m12" value="12. DB Tx: Update PENDING_PAYMENT, Sinh VietQR động" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;fontColor=#000000;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.770;entryX=0.5;entryY=0.770;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_order" target="ll_order" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell>
