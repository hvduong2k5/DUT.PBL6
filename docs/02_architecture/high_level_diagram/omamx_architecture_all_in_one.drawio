    <mxCell id="m11" value="11a. Publish: OrderPaidEvent -&gt; Thợ xưởng đóng gói" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;fontColor=#000000;strokeColor=#2e7d32;strokeWidth=1.5;endArrow=open;endFill=0;exitX=0.5;exitY=0.620;entryX=0.5;entryY=0.620;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_order" target="ll_kfk" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell>
    <mxCell id="m12" value="9b. ReserveStock -&gt; INSUFFICIENT_STOCK (available &amp;lt; qty)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;fontColor=#000000;strokeColor=#cc0000;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.710;entryX=0.5;entryY=0.710;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_order" target="ll_inv" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell>
