    <mxCell id="m2" value="2. Forward Webhook (Verify Secret Signature)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;fontColor=#000000;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.130;entryX=0.5;entryY=0.130;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_gw" target="ll_chan" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell>
    <mxCell id="m3" value="3. ACL Normalize: Shopee Item -&gt; SKU nội bộ MX-GION-500G" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;fontColor=#000000;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.180;entryX=0.5;entryY=0.180;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_chan" target="ll_chan" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell>
    <mxCell id="m4" value="4. HTTP 200 OK (trong 50ms)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;fontColor=#000000;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;exitX=0.5;exitY=0.230;entryX=0.5;entryY=0.230;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_chan" target="ll_gw" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell>
    <mxCell id="m5" value="5. HTTP 200 OK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;fontColor=#000000;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;exitX=0.5;exitY=0.280;entryX=0.5;entryY=0.280;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_gw" target="ll_shp" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell>
    <mxCell id="m6" value="6. Publish: MarketplaceOrderImportedEvent" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;fontColor=#000000;strokeColor=#2e7d32;strokeWidth=1.5;endArrow=open;endFill=0;exitX=0.5;exitY=0.340;entryX=0.5;entryY=0.340;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_chan" target="ll_kfk" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell>
    <mxCell id="m7" value="7. Consume: MarketplaceOrderImportedEvent" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;fontColor=#000000;strokeColor=#2e7d32;strokeWidth=1.5;endArrow=open;endFill=0;exitX=0.5;exitY=0.390;entryX=0.5;entryY=0.390;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_kfk" target="ll_order" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell>
    <mxCell id="m8" value="8. Tạo đơn IMPORTED_PENDING_STOCK, Saga=IN_PROGRESS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;fontColor=#000000;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.440;entryX=0.5;entryY=0.440;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_order" target="ll_order" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell>
