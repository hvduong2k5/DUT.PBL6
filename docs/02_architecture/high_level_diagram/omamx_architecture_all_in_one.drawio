    <mxCell id="ll_kfk" value="&lt;b&gt;Apache Kafka&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#4a148c;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=10;fontStyle=1;size=35;" vertex="1" parent="1"><mxGeometry x="710" y="70" width="150" height="700" as="geometry"/></mxCell>
