    <mxCell id="e_fin_db" value="&lt;b&gt;&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=8;fontColor=#000000;strokeColor=#444444;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="ms_fin" target="db_fin" parent="b_crm_fin"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="ms_not" value="&lt;b&gt;MS-17: notification-service&lt;/b&gt;&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;[Node.js, Port: 8017]&lt;/font&gt;&lt;br&gt;&lt;font style=&apos;font-size:8px&apos;&gt;Zalo ZNS, SMS Brandname, Email&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=10;" vertex="1" parent="b_crm_fin"><mxGeometry x="40" y="240" width="260" height="70" as="geometry"/></mxCell>
    <mxCell id="db_not" value="&lt;b&gt;Notification Queue&lt;/b&gt;&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;[Redis Queue]&lt;/font&gt;&lt;br&gt;&lt;font style=&apos;font-size:8px&apos;&gt;Hàng đợi gửi tin đa kênh&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#1565c0;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=10;" vertex="1" parent="b_crm_fin"><mxGeometry x="330" y="240" width="260" height="70" as="geometry"/></mxCell>
    <mxCell id="e_not_db" value="&lt;b&gt;&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=8;fontColor=#000000;strokeColor=#444444;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="ms_not" target="db_not" parent="b_crm_fin"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="ms_prf" value="&lt;b&gt;MS-15: profile-service&lt;/b&gt;&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;[Go, Port: 8015]&lt;/font&gt;&lt;br&gt;&lt;font style=&apos;font-size:8px&apos;&gt;Hồ sơ người dùng, sổ địa chỉ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=10;" vertex="1" parent="b_crm_fin"><mxGeometry x="40" y="340" width="260" height="70" as="geometry"/></mxCell>
    <mxCell id="ms_iam" value="&lt;b&gt;MS-16: identity-service&lt;/b&gt;&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;[Go, Port: 8016]&lt;/font&gt;&lt;br&gt;&lt;font style=&apos;font-size:8px&apos;&gt;Cấp phát JWT, 19 vai trò RBAC, JWKS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=10;" vertex="1" parent="b_crm_fin"><mxGeometry x="330" y="340" width="260" height="70" as="geometry"/></mxCell>
    <mxCell id="b_audit" value="Audit Plane (Mặt Phẳng Kiểm Toán Pháp Lý - Bất Khả Xâm)" style="swimlane;startSize=26;fillColor=#ffe0e0;strokeColor=#cc0000;fontStyle=1;fontSize=11;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="700" y="150" width="660" height="260" as="geometry"/></mxCell>
    <mxCell id="ms_aud" value="&lt;b&gt;MS-18: audit-service&lt;/b&gt;&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;[Go / Rust, Port: 8018]&lt;/font&gt;&lt;br&gt;&lt;font style=&apos;font-size:8px&apos;&gt;Ghi nhật ký bất biến, SHA-256 Hash Chain&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#cc0000;fontColor=#990000;fontSize=10;" vertex="1" parent="b_audit"><mxGeometry x="30" y="45" width="290" height="80" as="geometry"/></mxCell>
    <mxCell id="db_aud" value="&lt;b&gt;Audit DB&lt;/b&gt;&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;[PostgreSQL Append-Only]&lt;/font&gt;&lt;br&gt;&lt;font style=&apos;font-size:8px&apos;&gt;Bảng audit_records cấm UPDATE/DELETE&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#cc0000;fontColor=#990000;fontSize=10;" vertex="1" parent="b_audit"><mxGeometry x="350" y="45" width="280" height="80" as="geometry"/></mxCell>
    <mxCell id="e_aud_db" value="&lt;b&gt;INSERT Hash Chain&lt;/b&gt;&lt;br&gt;&lt;font style=&apos;font-size:8px;color:#666666&apos;&gt;[SQL Append-Only]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=8;fontColor=#000000;strokeColor=#cc0000;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="ms_aud" target="db_aud" parent="b_audit"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="ext_s3_worm" value="&lt;b&gt;AWS S3 Object Lock (WORM)&lt;/b&gt;&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;[Storage Ngoài]&lt;/font&gt;&lt;br&gt;&lt;font style=&apos;font-size:8px&apos;&gt;Lưu Merkle Root Checkpoint 1h&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8C8C8C;fontColor=#ffffff;fontSize=10;" vertex="1" parent="b_audit"><mxGeometry x="160" y="155" width="340" height="75" as="geometry"/></mxCell>
    <mxCell id="e_aud_worm" value="&lt;b&gt;Neo Merkle Root mỗi 1h&lt;/b&gt;&lt;br&gt;&lt;font style=&apos;font-size:8px;color:#666666&apos;&gt;[AWS S3 WORM]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=8;fontColor=#000000;strokeColor=#cc0000;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" source="ms_aud" target="ext_s3_worm" parent="b_audit"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="b_otel" value="Observability Plane (Mặt Phẳng Giám Sát Viễn Trắc)" style="swimlane;startSize=26;fillColor=#e8f4f8;strokeColor=#90caf9;fontStyle=1;fontSize=11;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="700" y="430" width="660" height="260" as="geometry"/></mxCell>
    <mxCell id="c_otel" value="&lt;b&gt;OpenTelemetry Collector&lt;/b&gt;&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;[OTel Core Agent]&lt;/font&gt;&lt;br&gt;&lt;font style=&apos;font-size:8px&apos;&gt;Thu gom Traces, Metrics, Logs (gRPC/HTTP 4317/4318)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1565c0;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=10;" vertex="1" parent="b_otel"><mxGeometry x="30" y="70" width="290" height="80" as="geometry"/></mxCell>
    <mxCell id="c_mon" value="&lt;b&gt;Monitoring Backends&lt;/b&gt;&lt;br&gt;&lt;font style=&apos;font-size:9px&apos;&gt;[Prometheus + Jaeger + Loki]&lt;/font&gt;&lt;br&gt;&lt;font style=&apos;font-size:8px&apos;&gt;Hạ tầng lưu trữ tín hiệu viễn trắc &amp; Grafana&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#1565c0;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=10;" vertex="1" parent="b_otel"><mxGeometry x="350" y="70" width="280" height="80" as="geometry"/></mxCell>
    <mxCell id="e_otel_mon" value="&lt;b&gt;OTLP Push&lt;/b&gt;&lt;br&gt;&lt;font style=&apos;font-size:8px;color:#666666&apos;&gt;[Metrics &amp; Traces]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=8;fontColor=#000000;strokeColor=#0066cc;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="c_otel" target="c_mon" parent="b_otel"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="e_kfk_care" value="&lt;b&gt;OrderCompleted&lt;/b&gt;&lt;br&gt;&lt;font style=&apos;font-size:8px;color:#666666&apos;&gt;[Kafka async]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=8;fontColor=#000000;strokeColor=#2e7d32;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;dashPattern=6 3;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="kafka_core" target="ms_care" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="-30" y="-12" as="offset"/></mxGeometry></mxCell>
    <mxCell id="e_kfk_fin" value="&lt;b&gt;OrderPaid&lt;/b&gt;&lt;br&gt;&lt;font style=&apos;font-size:8px;color:#666666&apos;&gt;[Kafka async]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=8;fontColor=#000000;strokeColor=#2e7d32;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;dashPattern=6 3;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="kafka_core" target="ms_fin" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="440" y="135"/><mxPoint x="25" y="135"/><mxPoint x="25" y="325"/></Array><mxPoint x="25" y="-15" as="offset"/></mxGeometry></mxCell>
    <mxCell id="e_kfk_not" value="&lt;b&gt;OrderPaid / Shipped&lt;/b&gt;&lt;br&gt;&lt;font style=&apos;font-size:8px;color:#666666&apos;&gt;[Kafka async]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=8;fontColor=#000000;strokeColor=#2e7d32;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;dashPattern=6 3;exitX=0.03;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="kafka_core" target="ms_not" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="120"/><mxPoint x="10" y="120"/><mxPoint x="10" y="425"/></Array><mxPoint x="25" y="-15" as="offset"/></mxGeometry></mxCell>
    <mxCell id="e_kfk_aud" value="&lt;b&gt;Consume audit.events&lt;/b&gt;&lt;br&gt;&lt;font style=&apos;font-size:8px;color:#666666&apos;&gt;[Kafka async]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=8;fontColor=#000000;strokeColor=#cc0000;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;dashPattern=6 3;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="kafka_core" target="ms_aud" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="680" y="235"/></Array><mxPoint x="20" y="-15" as="offset"/></mxGeometry></mxCell>
