    <mxCell id="e_f1_ok" value="Còn tồn kho" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#4caf50;strokeWidth=1.5;endArrow=block;endFill=1;;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="mkt_inv" target="mkt_ok" parent="box_f1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="0" as="offset" /></mxGeometry></mxCell>
    <mxCell id="e_f1_fl" value="Hết hàng" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#e53935;strokeWidth=1.5;endArrow=block;endFill=1;;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="mkt_inv" target="mkt_fail" parent="box_f1"><mxGeometry relative="1" as="geometry"><mxPoint x="30" y="0" as="offset" /></mxGeometry></mxCell>
    <mxCell id="box_f2" value="LUỒNG 2: BÁN LẺ TRỰC TIẾP TẠI QUẦY XƯỞNG HƯƠNG THỦY (OFFLINE-FIRST POS — ĐỘ TRỄ DƯỚI 50MS)" style="swimlane;startSize=28;fillColor=#e1f5fe;strokeColor=#0288d1;fontStyle=1;fontSize=12.5;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="1380" height="310" as="geometry" /></mxCell>
    <mxCell id="pos_dev" value="Máy POS Quầy Xưởng&lt;br&gt;&lt;i&gt;(Thu ngân quét barcode)&lt;/i&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11.5;fontStyle=1;" vertex="1" parent="box_f2"><mxGeometry x="30" y="60" width="200" height="65" as="geometry" /></mxCell>
    <mxCell id="pos_ms13" value="MS-13: POS Client Node&lt;br&gt;&lt;i&gt;(Xác thực ca bán &amp;amp; Tiền mặt)&lt;/i&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11.5;fontStyle=1;" vertex="1" parent="box_f2"><mxGeometry x="300" y="60" width="220" height="65" as="geometry" /></mxCell>
    <mxCell id="pos_ms04" value="MS-04: CreatePOSOrder&lt;br&gt;&lt;i&gt;(Tạo thẳng trạng thái PAID)&lt;/i&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#1565c0;fontColor=#ffffff;fontSize=11.5;fontStyle=1;" vertex="1" parent="box_f2"><mxGeometry x="590" y="60" width="230" height="65" as="geometry" /></mxCell>
    <mxCell id="pos_db" value="PostgreSQL 16 DB&lt;br&gt;&lt;i&gt;(Ghi nhận đơn POS 15ms)&lt;/i&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#303f9f;fontColor=#ffffff;fontSize=11.5;fontStyle=1;" vertex="1" parent="box_f2"><mxGeometry x="890" y="55" width="200" height="75" as="geometry" /></mxCell>
    <mxCell id="pos_inv" value="MS-01: Inventory&lt;br&gt;&lt;i&gt;(Trừ tồn kho vật lý tại xưởng)&lt;/i&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#00796b;fontColor=#ffffff;fontSize=11.5;fontStyle=1;" vertex="1" parent="box_f2"><mxGeometry x="1150" y="60" width="200" height="65" as="geometry" /></mxCell>
    <mxCell id="pos_feat" value="&lt;b&gt;ĐẶC TÍNH BÁN HÀNG TẠI QUẦY (POS RETAIL):&lt;/b&gt;&lt;br&gt;• Đơn hàng sinh ra ở trạng thái &lt;code&gt;PAID&lt;/code&gt; ngay lập tức, không qua giai đoạn chờ &lt;code&gt;PENDING_PAYMENT&lt;/code&gt;.&lt;br&gt;• Hỗ trợ thanh toán Tiền mặt, Quẹt thẻ POS hoặc VietQR quầy tĩnh.&lt;br&gt;• Xuất hóa đơn VAT điện tử và trừ trực tiếp tồn kho thực tế của xưởng Hương Thủy trong &lt;b&gt;dưới 50 mili-giây&lt;/b&gt;." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0288d1;fontSize=11.5;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="box_f2"><mxGeometry x="300" y="165" width="800" height="100" as="geometry" /></mxCell>
    <mxCell id="e_f2_1" value="1. Quét mã kẹo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#0288d1;strokeWidth=1.5;endArrow=block;endFill=1;;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="pos_dev" target="pos_ms13" parent="box_f2"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset" /></mxGeometry></mxCell>
    <mxCell id="e_f2_2" value="2. gRPC CreatePOSOrder()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#1565c0;strokeWidth=1.5;endArrow=block;endFill=1;;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="pos_ms13" target="pos_ms04" parent="box_f2"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset" /></mxGeometry></mxCell>
    <mxCell id="e_f2_3" value="3. INSERT PAID (UUID v7)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#303f9f;strokeWidth=1.5;endArrow=block;endFill=1;;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="pos_ms04" target="pos_db" parent="box_f2"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset" /></mxGeometry></mxCell>
    <mxCell id="e_f2_4" value="4. Trừ tồn vật lý" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#00796b;strokeWidth=1.5;endArrow=block;endFill=1;;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" source="pos_ms04" target="pos_inv" parent="box_f2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="705" y="145" /><mxPoint x="1250" y="145" /></Array><mxPoint x="0" y="-14" as="offset" /></mxGeometry></mxCell>
    <mxCell id="lbl_omni_note" value="&lt;b&gt;KIẾN TRÚC OMNICHANNEL TOÀN DIỆN:&lt;/b&gt; Hợp nhất dữ liệu đơn hàng từ Website D2C, Ứng dụng Di động, Gian hàng Shopee/TikTok Mall, và Điểm bán lẻ POS xưởng Huế về một đầu mối kiểm soát duy nhất tại MS-04!" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#b0bec5;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="1380" height="36" as="geometry" /></mxCell>
