    <mxCell id="t1" value="&lt;b&gt;Sơ Đồ 1: Kiến Trúc Phân Tầng &amp;amp; Ranh Giới Dữ Liệu (MS-04 Order Service Topology)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=17;fontColor=#1a237e;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="10" width="950" height="35" as="geometry" /></mxCell>
    <mxCell id="c_d2c" value="Web D2C &amp;amp; Mobile App&lt;br&gt;&lt;i&gt;(Next.js 14 / Flutter)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=11.5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="180" height="42" as="geometry" /></mxCell>
    <mxCell id="c_pos" value="POS Quầy Xưởng &amp;amp; CMS&lt;br&gt;&lt;i&gt;(React SPA, Offline-first)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=11.5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="102" width="180" height="42" as="geometry" /></mxCell>
    <mxCell id="gw_kong" value="Kong API Gateway&lt;br&gt;&lt;i&gt;(North-South TLS, JWT, RateLimit, Port 8004)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ff8f00;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="55" width="230" height="72" as="geometry" /></mxCell>
    <mxCell id="ms13_channel" value="MS-13: channel-service&lt;br&gt;&lt;i&gt;(Shopee / TikTok Mall ACL)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6a1b9a;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="570" y="55" width="230" height="72" as="geometry" /></mxCell>
    <mxCell id="ms15_profile" value="MS-15: profile-service&lt;br&gt;&lt;i&gt;(Address Resolution gRPC)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00796b;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="840" y="55" width="230" height="72" as="geometry" /></mxCell>
    <mxCell id="ms18_audit" value="MS-18: audit-service&lt;br&gt;&lt;i&gt;(WORM Hash Chain Plane)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c2185b;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1110" y="55" width="230" height="72" as="geometry" /></mxCell>
    <mxCell id="b_boundary" value="RANH GIỚI SỞ HỮU DỮ LIỆU (DATA BOUNDARIES)" style="swimlane;startSize=28;fillColor=#fffde7;strokeColor=#fbc02d;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="175" width="290" height="510" as="geometry" /></mxCell>
    <mxCell id="b_ms04" value="&lt;b&gt;MS-04 Order Service (Độc Quyền):&lt;/b&gt;&lt;br&gt;• Quản lý Aggregate Order &amp;amp; FSM Status&lt;br&gt;• Snapshots bất biến (Địa chỉ, Voucher)&lt;br&gt;• Tính toán số học Money VND an toàn&lt;br&gt;❌ &lt;i&gt;Cấm sửa đơn hàng sau khi PAID&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="b_boundary"><mxGeometry x="12" y="36" width="266" height="85" as="geometry" /></mxCell>
    <mxCell id="b_ms01" value="&lt;b&gt;MS-01 Inventory Service:&lt;/b&gt;&lt;br&gt;• Tồn kho 3 trạng thái: avail ──► resv ──► comm&lt;br&gt;• Khóa tồn FEFO 15 phút (ReserveStock)&lt;br&gt;• Nhả tồn kho khi hủy đơn (ReleaseReservation)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="b_boundary"><mxGeometry x="12" y="131" width="266" height="85" as="geometry" /></mxCell>
    <mxCell id="b_ms07" value="&lt;b&gt;MS-07 Promotion Service:&lt;/b&gt;&lt;br&gt;• Thẩm định voucher &amp;amp; ngân sách khuyến mãi&lt;br&gt;• Mở lại mã khi đơn hủy timeout&lt;br&gt;• Nhận OrderCompletedEvent tích điểm 1% Xu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="b_boundary"><mxGeometry x="12" y="226" width="266" height="85" as="geometry" /></mxCell>
    <mxCell id="b_model_a" value="&lt;b&gt;Centralized Compensation Model A:&lt;/b&gt;&lt;br&gt;• Duy nhất Saga Orchestrator của MS-04&lt;br&gt;phát lệnh hoàn tác tài nguyên sang các service vệ tinh" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="b_boundary"><mxGeometry x="12" y="321" width="266" height="75" as="geometry" /></mxCell>
    <mxCell id="b_invariant" value="&lt;b&gt;Bất Biến Kiểm Tra Nghiệp Vụ:&lt;/b&gt;&lt;br&gt;• discount_units &amp;lt;= subtotal_units&lt;br&gt;• final_units = subtotal - discount + shipping&lt;br&gt;• Bắt buộc khớp tuyệt đối: amount == final" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#e57373;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="b_boundary"><mxGeometry x="12" y="406" width="266" height="90" as="geometry" /></mxCell>
    <mxCell id="ms04_main" value="CONTAINER: MS-04 ORDER SERVICE (GO 1.22 — CLEAN ARCHITECTURE)" style="swimlane;startSize=28;fillColor=#f0f7ff;strokeColor=#0066cc;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="370" y="175" width="890" height="510" as="geometry" /></mxCell>
    <mxCell id="l_inbound" value="1. Inbound Delivery Adapters" style="swimlane;startSize=24;fillColor=#e8f4f8;strokeColor=#90caf9;fontStyle=1;fontSize=12;" vertex="1" parent="ms04_main"><mxGeometry x="20" y="38" width="850" height="85" as="geometry" /></mxCell>
    <mxCell id="h_rest" value="HTTP REST Handlers (Gin) — Port 8004&lt;br&gt;&lt;i&gt;/api/v1/checkout, /api/v1/orders/**, /api/v1/cart/**, /payments/vietqr/callback&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11.5;fontStyle=1;" vertex="1" parent="l_inbound"><mxGeometry x="15" y="30" width="400" height="45" as="geometry" /></mxCell>
    <mxCell id="h_grpc" value="gRPC Server (OrderService) — Port 8004&lt;br&gt;&lt;i&gt;CreatePOSOrder(), GetOrderDetail(), CancelOrder()&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11.5;fontStyle=1;" vertex="1" parent="l_inbound"><mxGeometry x="435" y="30" width="400" height="45" as="geometry" /></mxCell>
    <mxCell id="l_engines" value="2. Core Application Use Cases &amp;amp; Saga Engines" style="swimlane;startSize=24;fillColor=#e8f5e9;strokeColor=#a5d6a7;fontStyle=1;fontSize=12;" vertex="1" parent="ms04_main"><mxGeometry x="20" y="138" width="850" height="145" as="geometry" /></mxCell>
    <mxCell id="eng_order" value="Order Domain Engine (OCC CAS version+1)&lt;br&gt;&lt;i&gt;CalculateTotals(), SnapshotCreator, Invariant Math Checker&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11.5;" vertex="1" parent="l_engines"><mxGeometry x="15" y="32" width="400" height="48" as="geometry" /></mxCell>
    <mxCell id="eng_saga" value="Saga Orchestrator Engine (Model A)&lt;br&gt;&lt;i&gt;CheckoutSaga, Sweeper 15s CAS, Centralized Compensation&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11.5;" vertex="1" parent="l_engines"><mxGeometry x="435" y="32" width="400" height="48" as="geometry" /></mxCell>
    <mxCell id="eng_domain" value="Domain Aggregates: Order Root, OrderLineItem, PaymentTransaction, AddressSnapshot, Money VND" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f8e9;strokeColor=#81c784;fontStyle=2;fontSize=11.5;" vertex="1" parent="l_engines"><mxGeometry x="15" y="90" width="820" height="42" as="geometry" /></mxCell>
