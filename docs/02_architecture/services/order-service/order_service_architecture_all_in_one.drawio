    <mxCell id="st_dlq" value="DEAD_LETTER&lt;br&gt;&lt;i&gt;Quá 5 lần thất bại (Báo động Ops)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcdd2;strokeColor=#d32f2f;fontStyle=1;fontSize=12.5;" vertex="1" parent="1"><mxGeometry x="880" y="500" width="250" height="80" as="geometry" /></mxCell>
    <mxCell id="end_dlq" value="" style="shape=ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1180" y="525" width="30" height="30" as="geometry" /></mxCell>
    <mxCell id="box_cas" value="&lt;b&gt;GIẢI PHÁP TRANH CHẤP TRẠNG THÁI GIÂY THỨ 900 (SECOND-899 RACE CONDITION):&lt;/b&gt;&lt;br&gt;&lt;br&gt; Tại giây thứ 899 (ngay trước hạn chót 15:00), Webhook thanh toán VietQR và Timeout Sweeper cùng gọi vào hệ thống đồng thời:&lt;br&gt; • Cả 2 luồng đều thực thi lệnh &lt;b&gt;Atomic CAS&lt;/b&gt; trên PostgreSQL:&lt;br&gt;   &lt;code&gt;UPDATE orders SET status = $1, version = version + 1 WHERE id = $ID AND status = 'PENDING_PAYMENT' AND version = $VER;&lt;/code&gt;&lt;br&gt; • Luồng nào đến DB trước sẽ có &lt;code&gt;RowsAffected == 1&lt;/code&gt; (Chiến thắng, chuyển trạng thái thành công).&lt;br&gt; • Luồng đến sau nhận &lt;code&gt;RowsAffected == 0&lt;/code&gt; (Thất bại tức thì, tự động hủy bỏ tác vụ).&lt;br&gt; • &lt;b&gt;Nếu Webhook đến sau khi Timeout đã hủy đơn:&lt;/b&gt; Đơn hàng giữ nguyên &lt;code&gt;CANCELLED_TIMEOUT&lt;/code&gt;, ghi nhận &lt;code&gt;RECONCILIATION_REQUIRED&lt;/code&gt; để hoàn tiền 100% cho khách, bảo đảm không bị mất tiền hay xuất kho sai lệch!" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#b0bec5;fontSize=11.5;align=left;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="110" y="615" width="1100" height="160" as="geometry" /></mxCell>
    <mxCell id="e_s_st" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="start" target="st_started" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="e_st_pr" value="gRPC đầu tiên" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#2e7d32;strokeWidth=1.5;endArrow=block;endFill=1;;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="st_started" target="st_progress" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset" /></mxGeometry></mxCell>
    <mxCell id="e_pr_cp" value="Tất cả bước OK" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#2e7d32;strokeWidth=1.5;endArrow=block;endFill=1;;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="st_progress" target="st_comp" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset" /></mxGeometry></mxCell>
    <mxCell id="e_cp_end" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#2e7d32;strokeWidth=1.5;endArrow=block;endFill=1;;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="st_comp" target="end_comp" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="e_pr_cm" value="Lỗi / Quá hạn 15m" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#f57c00;strokeWidth=1.5;endArrow=block;endFill=1;;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="st_progress" target="st_compensating" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="50" y="0" as="offset" /></mxGeometry></mxCell>
    <mxCell id="e_cm_cd" value="Đền bù thành công" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#455a64;strokeWidth=1.5;endArrow=block;endFill=1;;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="st_compensating" target="st_compensated" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset" /></mxGeometry></mxCell>
    <mxCell id="e_cd_end" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#455a64;strokeWidth=1.5;endArrow=block;endFill=1;;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="st_compensated" target="end_compensated" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="e_cm_rt" value="Lỗi mạng đền bù" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#fbc02d;strokeWidth=1.5;endArrow=block;endFill=1;;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" source="st_compensating" target="st_retrying" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="45" y="0" as="offset" /></mxGeometry></mxCell>
    <mxCell id="e_rt_cm" value="Thử lại sau Backoff" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#2e7d32;strokeWidth=1.5;endArrow=block;endFill=1;;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" source="st_retrying" target="st_compensating" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="55" y="0" as="offset" /></mxGeometry></mxCell>
    <mxCell id="e_rt_dl" value="Thất bại &gt; 5 lần" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#d32f2f;strokeWidth=1.5;endArrow=block;endFill=1;;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="st_retrying" target="st_dlq" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset" /></mxGeometry></mxCell>
    <mxCell id="e_dl_end" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#d32f2f;strokeWidth=1.5;endArrow=block;endFill=1;;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="st_dlq" target="end_dlq" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
  </root>
</mxGraphModel></diagram><diagram name="06. Checkout D2C Sequence"><mxGraphModel dx="1460" dy="880" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="880" math="0" shadow="0">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />
    <mxCell id="t6" value="&lt;b&gt;Sơ Đồ 6: Luồng Khởi Tạo Đơn Hàng Checkout D2C Song Song (Critical Path Latency P95 ~ 140ms &amp;lt; 200ms)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=17;fontColor=#1a237e;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="250" y="15" width="950" height="35" as="geometry" /></mxCell>
    <mxCell id="ll_cust" value="&lt;b&gt;Khách Hàng (D2C)&lt;br&gt;Web / Mobile App&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#0288d1;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=12.5;fontStyle=1;size=38;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="170" height="720" as="geometry" /></mxCell>
    <mxCell id="ll_kong" value="&lt;b&gt;Kong API Gateway&lt;br&gt;(JWT Local JWKS)&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#ff8f00;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=12.5;fontStyle=1;size=38;" vertex="1" parent="1"><mxGeometry x="260" y="65" width="170" height="720" as="geometry" /></mxCell>
    <mxCell id="ll_order" value="&lt;b&gt;MS-04: order-service&lt;br&gt;(CheckoutD2C)&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#1565c0;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=12.5;fontStyle=1;size=38;" vertex="1" parent="1"><mxGeometry x="480" y="65" width="180" height="720" as="geometry" /></mxCell>
    <mxCell id="ll_peers" value="&lt;b&gt;MS-15, MS-05, MS-07&lt;br&gt;(Parallel errgroup)&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#00796b;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=12.5;fontStyle=1;size=38;" vertex="1" parent="1"><mxGeometry x="720" y="65" width="190" height="720" as="geometry" /></mxCell>
    <mxCell id="ll_inv" value="&lt;b&gt;MS-01: inventory&lt;br&gt;(ReserveStock 15m)&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#2e7d32;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=12.5;fontStyle=1;size=38;" vertex="1" parent="1"><mxGeometry x="970" y="65" width="180" height="720" as="geometry" /></mxCell>
    <mxCell id="ll_db" value="&lt;b&gt;PostgreSQL 16 &amp;amp; Redis&lt;br&gt;(Local ACID Commit)&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#303f9f;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=12.5;fontStyle=1;size=38;" vertex="1" parent="1"><mxGeometry x="1210" y="65" width="190" height="720" as="geometry" /></mxCell>
    <mxCell id="m1" value="1. POST /api/v1/checkout (JWT, CartItems, Address, Voucher)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#0288d1;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.080;entryX=0.5;entryY=0.080;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_cust" target="ll_kong" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m2" value="2. Validate JWT (Cached JWKS 10ms) + Idempotency Check" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#ff8f00;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.140;entryX=0.5;entryY=0.140;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_kong" target="ll_kong" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="35" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m3" value="3. Forward Request + Header X-User-Id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#ff8f00;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.200;entryX=0.5;entryY=0.200;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_kong" target="ll_order" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="box_par" value="&lt;b&gt;SONG SONG HÓA gRPC (errgroup &amp;lt; 35ms):&lt;/b&gt;&lt;br&gt;• MS-15: GetDeliveryAddress() (5ms)&lt;br&gt;• MS-05: ValidatePriceAndSKU() (30ms)&lt;br&gt;• MS-07: ValidateVoucher() (25ms)&lt;br&gt;• MS-12: CalculateShippingFee() (20ms)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#e8f5e9;strokeColor=#4caf50;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="600" y="240" width="280" height="75" as="geometry" /></mxCell>
    <mxCell id="m4" value="4. errgroup: Thẩm định đồng thời Giá, Voucher, Phí ship, Địa chỉ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#00796b;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.380;entryX=0.5;entryY=0.380;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_order" target="ll_peers" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m5" value="5. Toàn bộ xác thực hợp lệ (P95 ~ 35ms)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#00796b;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;exitX=0.5;exitY=0.450;entryX=0.5;entryY=0.450;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_peers" target="ll_order" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m6" value="6. gRPC ReserveStock(order_id, items, ttl=15m)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#2e7d32;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.520;entryX=0.5;entryY=0.520;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_order" target="ll_inv" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m7" value="7. SELECT FOR UPDATE: Khóa tồn kho FEFO (45ms)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#2e7d32;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.580;entryX=0.5;entryY=0.580;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_inv" target="ll_inv" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="35" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m8" value="8. RESERVATION_SUCCESS (status: RESERVED)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#2e7d32;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;exitX=0.5;exitY=0.640;entryX=0.5;entryY=0.640;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_inv" target="ll_order" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m9" value="9. BEGIN ACID Tx: INSERT orders, items, snapshots, saga, outbox" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#303f9f;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.710;entryX=0.5;entryY=0.710;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_order" target="ll_db" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m10" value="10. COMMIT OK (UUID v7, PENDING_PAYMENT, expires_at=15m)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#303f9f;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;exitX=0.5;exitY=0.770;entryX=0.5;entryY=0.770;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_db" target="ll_order" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m11" value="11. Sinh mã VietQR động + Lưu Idempotency Cache" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#1565c0;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.830;entryX=0.5;entryY=0.830;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_order" target="ll_order" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="35" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m12" value="12. HTTP 201 Created (order_code, VietQR URL, 900s countdown)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#1565c0;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.890;entryX=0.5;entryY=0.890;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_order" target="ll_kong" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m13" value="13. Màn hình Quét VietQR chuyển khoản (Đếm ngược 15:00)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#0288d1;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.950;entryX=0.5;entryY=0.950;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_kong" target="ll_cust" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="lbl_budget" value="&lt;b&gt;TỔNG THỜI GIAN ĐỘ TRỄ THỰC THI (LATENCY BUDGET):&lt;/b&gt; 10ms (Kong) + 5ms (Idemp) + 35ms (gRPC) + 45ms (Kho) + 30ms (DB) + 15ms (Net) = &lt;b&gt;140ms (Vượt chuẩn NFR-01 P95 &amp;lt; 200ms)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#4caf50;fontSize=11.5;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="260" y="800" width="960" height="40" as="geometry" /></mxCell>
  </root>
</mxGraphModel></diagram><diagram name="07. Payment Webhook Reconcile"><mxGraphModel dx="1490" dy="880" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1490" pageHeight="880" math="0" shadow="0">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />
    <mxCell id="t7" value="&lt;b&gt;Sơ Đồ 7: Luồng Đối Soát Webhook VietQR &amp;amp; Kích Hoạt Đóng Gói (Payment Webhook &amp;amp; 5 Scenarios)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=17;fontColor=#1a237e;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="250" y="15" width="950" height="35" as="geometry" /></mxCell>
    <mxCell id="ll_bank" value="&lt;b&gt;Cổng VietQR / Ngân Hàng&lt;br&gt;(VietinBank/MB/Napas)&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#455a64;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=12.5;fontStyle=1;size=38;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="180" height="720" as="geometry" /></mxCell>
    <mxCell id="ll_kong" value="&lt;b&gt;Kong API Gateway&lt;br&gt;(RateLimit &amp;amp; TLS)&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#ff8f00;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=12.5;fontStyle=1;size=38;" vertex="1" parent="1"><mxGeometry x="280" y="65" width="170" height="720" as="geometry" /></mxCell>
    <mxCell id="ll_order" value="&lt;b&gt;MS-04: order-service&lt;br&gt;(Webhook Controller)&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#1565c0;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=12.5;fontStyle=1;size=38;" vertex="1" parent="1"><mxGeometry x="510" y="65" width="190" height="720" as="geometry" /></mxCell>
    <mxCell id="ll_db" value="&lt;b&gt;PostgreSQL 16 DB&lt;br&gt;(payments, orders, outbox)&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#303f9f;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=12.5;fontStyle=1;size=38;" vertex="1" parent="1"><mxGeometry x="760" y="65" width="190" height="720" as="geometry" /></mxCell>
    <mxCell id="ll_kfk" value="&lt;b&gt;Apache Kafka Broker&lt;br&gt;(order.events.v1)&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#2e7d32;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=12.5;fontStyle=1;size=38;" vertex="1" parent="1"><mxGeometry x="1010" y="65" width="180" height="720" as="geometry" /></mxCell>
    <mxCell id="ll_down" value="&lt;b&gt;MS-02 Kho &amp;amp; MS-17 Zalo&lt;br&gt;(Downstream Consumers)&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#00796b;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=12.5;fontStyle=1;size=38;" vertex="1" parent="1"><mxGeometry x="1250" y="65" width="190" height="720" as="geometry" /></mxCell>
    <mxCell id="m1" value="1. Webhook POST /payments/vietqr/callback (HMAC-SHA256, TxID)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#455a64;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.090;entryX=0.5;entryY=0.090;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_bank" target="ll_kong" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m2" value="2. Forward Webhook Request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#ff8f00;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.150;entryX=0.5;entryY=0.150;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_kong" target="ll_order" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m3" value="3. ConstantTimeCompare(HMAC, Secret) — Chống Timing Attack" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#1565c0;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.220;entryX=0.5;entryY=0.220;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_order" target="ll_order" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="35" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="box_scen" value="&lt;b&gt;ĐỐI SOÁT 5 KỊCH BẢN THANH TOÁN:&lt;/b&gt;&lt;br&gt;1. Khớp chuẩn (amount == final): Chuyển PAID.&lt;br&gt;2. Chuyển thiếu: Giữ PENDING, gửi SMS nhắc nợ.&lt;br&gt;3. Chuyển thừa: Chuyển PAID + Tạo hoàn tiền thừa.&lt;br&gt;4. Trùng lặp: Chặn bởi Unique Constraint CSDL.&lt;br&gt;5. Chuyển sau Timeout: Giữ CANCELLED, hoàn 100%." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9c4;strokeColor=#fbc02d;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="640" y="240" width="290" height="95" as="geometry" /></mxCell>
    <mxCell id="m4" value="4. BEGIN Tx: Atomic CAS UPDATE orders SET status='PAID' (version+1)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#303f9f;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.480;entryX=0.5;entryY=0.480;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_order" target="ll_db" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m5" value="5. INSERT INTO payments (provider, tx_id, amount, 'PAID')" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#303f9f;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.540;entryX=0.5;entryY=0.540;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_order" target="ll_db" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m6" value="6. INSERT INTO outbox_events (OrderPaidEvent) -&gt; COMMIT Tx" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#303f9f;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.600;entryX=0.5;entryY=0.600;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_order" target="ll_db" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m7" value="7. Commit Thành Công (Dưới 50ms)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#303f9f;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;exitX=0.5;exitY=0.660;entryX=0.5;entryY=0.660;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_db" target="ll_order" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m8" value="8. HTTP 200 OK (Xác nhận đã xử lý)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#1565c0;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.720;entryX=0.5;entryY=0.720;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_order" target="ll_kong" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m9" value="9. HTTP 200 OK (Ngắt retry từ Ngân hàng)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#455a64;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.780;entryX=0.5;entryY=0.780;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_kong" target="ll_bank" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m10" value="10. Outbox Poller: Publish OrderPaidEvent (topic: order.events.v1)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#2e7d32;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;exitX=0.5;exitY=0.850;entryX=0.5;entryY=0.850;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_order" target="ll_kfk" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m11" value="11. MS-02 tạo Picking Task gói kẹo &amp; MS-17 gửi Zalo ZNS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#00796b;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;exitX=0.5;exitY=0.920;entryX=0.5;entryY=0.920;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_kfk" target="ll_down" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="lbl_wh_note" value="&lt;b&gt;CAM KẾT NHẤT QUÁN &amp;amp; IDEMPOTENCY:&lt;/b&gt; Sử dụng ràng buộc &lt;code&gt;UNIQUE (payment_provider, provider_transaction_id)&lt;/code&gt; triệt tiêu hoàn toàn rủi ro ghi nhận doanh thu 2 lần khi Ngân hàng retry callback!" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#4caf50;fontSize=11.5;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="260" y="800" width="960" height="40" as="geometry" /></mxCell>
  </root>
</mxGraphModel></diagram><diagram name="08. Timeout &amp; Compensation"><mxGraphModel dx="1550" dy="880" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1550" pageHeight="880" math="0" shadow="0">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />
    <mxCell id="t8" value="&lt;b&gt;Sơ Đồ 8: Luồng Quét Quá Giờ &amp;amp; Đền Bù Tập Trung (Timeout Sweeper &amp;amp; Centralized Compensation Model A)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=17;fontColor=#1a237e;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="250" y="15" width="950" height="35" as="geometry" /></mxCell>
    <mxCell id="ll_sweep" value="&lt;b&gt;Timeout Sweeper Daemon&lt;br&gt;(Quét chu kỳ 15s)&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f57c00;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=12.5;fontStyle=1;size=38;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="190" height="725" as="geometry" /></mxCell>
    <mxCell id="ll_db" value="&lt;b&gt;PostgreSQL 16 DB&lt;br&gt;(orders &amp;amp; saga_instances)&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#303f9f;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=12.5;fontStyle=1;size=38;" vertex="1" parent="1"><mxGeometry x="290" y="60" width="190" height="725" as="geometry" /></mxCell>
    <mxCell id="ll_saga" value="&lt;b&gt;MS-04: Saga Engine&lt;br&gt;(Model A Orchestrator)&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#1565c0;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=12.5;fontStyle=1;size=38;" vertex="1" parent="1"><mxGeometry x="550" y="60" width="190" height="725" as="geometry" /></mxCell>
    <mxCell id="ll_inv" value="&lt;b&gt;MS-01: inventory&lt;br&gt;(ReleaseReservation)&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#2e7d32;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=12.5;fontStyle=1;size=38;" vertex="1" parent="1"><mxGeometry x="810" y="60" width="180" height="725" as="geometry" /></mxCell>
    <mxCell id="ll_promo" value="&lt;b&gt;MS-07: promotion&lt;br&gt;(ReleaseVoucher)&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#512da8;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=12.5;fontStyle=1;size=38;" vertex="1" parent="1"><mxGeometry x="1060" y="60" width="180" height="725" as="geometry" /></mxCell>
    <mxCell id="ll_kfk" value="&lt;b&gt;Apache Kafka Broker&lt;br&gt;(OrderCancelledEvent)&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#455a64;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=12.5;fontStyle=1;size=38;" vertex="1" parent="1"><mxGeometry x="1310" y="60" width="180" height="725" as="geometry" /></mxCell>
    <mxCell id="m1" value="1. SELECT id, version FROM orders WHERE status='PENDING_PAYMENT' AND expires_at &amp;lt; NOW()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#f57c00;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.120;entryX=0.5;entryY=0.120;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_sweep" target="ll_db" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m2" value="2. Trả về danh sách đơn quá hạn 15:00" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#303f9f;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;exitX=0.5;exitY=0.180;entryX=0.5;entryY=0.180;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_db" target="ll_sweep" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m3" value="3. UPDATE orders SET status='CANCELLED_TIMEOUT' WHERE id=$1 AND version=$2 (CAS)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#f57c00;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.250;entryX=0.5;entryY=0.250;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_sweep" target="ll_db" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m4" value="4. RowsAffected == 1 (Thành công) ──► Kích hoạt đền bù" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#303f9f;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;exitX=0.5;exitY=0.310;entryX=0.5;entryY=0.310;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_db" target="ll_sweep" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m5" value="5. Trigger Compensation (order_id, Model A Centralized)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#1565c0;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.380;entryX=0.5;entryY=0.380;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_sweep" target="ll_saga" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m6" value="6. UPDATE saga_instances SET status = 'COMPENSATING'" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#1565c0;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.440;entryX=0.5;entryY=0.440;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_saga" target="ll_db" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m7" value="7. gRPC ReleaseReservation(order_id, PAYMENT_TIMEOUT)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#2e7d32;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.520;entryX=0.5;entryY=0.520;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_saga" target="ll_inv" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m8" value="8. Xóa stock_reservations, hoàn trả tồn kho khả dụng" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#2e7d32;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.580;entryX=0.5;entryY=0.580;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_inv" target="ll_inv" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="35" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m9" value="9. RELEASED_SUCCESS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#2e7d32;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;exitX=0.5;exitY=0.640;entryX=0.5;entryY=0.640;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_inv" target="ll_saga" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m10" value="10. gRPC ReleaseVoucher(voucher_code, customer_id)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#512da8;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.710;entryX=0.5;entryY=0.710;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_saga" target="ll_promo" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m11" value="11. VOUCHER_UNLOCKED (Khách có thể dùng lại mã)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#512da8;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;exitX=0.5;exitY=0.770;entryX=0.5;entryY=0.770;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_promo" target="ll_saga" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m12" value="12. UPDATE saga_instances SET status = 'COMPENSATED'" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#1565c0;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.830;entryX=0.5;entryY=0.830;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_saga" target="ll_db" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="m13" value="13. Publish OrderCancelledEvent (Mục đích thông báo, KHÔNG PHẢI LỆNH ĐỀN BÙ)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#455a64;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;exitX=0.5;exitY=0.900;entryX=0.5;entryY=0.900;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_saga" target="ll_kfk" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
    <mxCell id="lbl_comp_note" value="&lt;b&gt;TẠI SAO CHỌN MODEL A (ĐỀN BÙ TẬP TRUNG)?&lt;/b&gt; Không phụ thuộc vào Kafka khi đền bù khẩn cấp. Order Service trực tiếp gọi gRPC sang Kho &amp;amp; Voucher, bảo đảm tính tất định và dữ liệu tồn kho được giải phóng ngay lập tức!" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ffb74d;fontSize=11.5;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="260" y="800" width="960" height="40" as="geometry" /></mxCell>
  </root>
</mxGraphModel></diagram><diagram name="09. Omnichannel &amp; POS Flow"><mxGraphModel dx="1460" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="800" math="0" shadow="0">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />
    <mxCell id="t9" value="&lt;b&gt;Sơ Đồ 9: Luồng Tiếp Nhận Đơn Hàng Đa Kênh (Marketplace Shopee/TikTok &amp;amp; POS Quầy Xưởng)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=17;fontColor=#1a237e;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="250" y="15" width="950" height="35" as="geometry" /></mxCell>
    <mxCell id="box_f1" value="LUỒNG 1: TIẾP NHẬN ĐƠN SÀN TMĐT SHOPEE / TIKTOK SHOP (ASYNC EVENT-DRIVEN SAGA)" style="swimlane;startSize=28;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontStyle=1;fontSize=12.5;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1380" height="330" as="geometry" /></mxCell>
    <mxCell id="mkt_ext" value="Sàn Shopee / TikTok&lt;br&gt;&lt;i&gt;(Webhook POST đơn mới)&lt;/i&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11.5;fontStyle=1;" vertex="1" parent="box_f1"><mxGeometry x="30" y="50" width="190" height="60" as="geometry" /></mxCell>
    <mxCell id="mkt_ch" value="MS-13: channel-service&lt;br&gt;&lt;i&gt;(ACL mapping SKU &amp;amp; Verify)&lt;/i&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11.5;fontStyle=1;" vertex="1" parent="box_f1"><mxGeometry x="280" y="50" width="210" height="60" as="geometry" /></mxCell>
