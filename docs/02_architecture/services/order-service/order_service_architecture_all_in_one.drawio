    <mxCell id="mkt_inv" value="MS-01: inventory-service&lt;br&gt;&lt;i&gt;(Khóa tồn kho hàng sẵn có)&lt;/i&gt;" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#00796b;fontColor=#ffffff;fontSize=11.5;fontStyle=1;" vertex="1" parent="box_f1"><mxGeometry x="1100" y="50" width="220" height="60" as="geometry" /></mxCell>
    <mxCell id="mkt_ok" value="KHO CÒN HÀNG (HAPPY PATH):&lt;br&gt;• Tạo đơn nội bộ status = 'PAID'&lt;br&gt;• Ghi Outbox OrderPaidEvent gói kẹo&lt;br&gt;• Cập nhật Saga ──► COMPLETED" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#4caf50;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="box_f1"><mxGeometry x="810" y="160" width="250" height="75" as="geometry" /></mxCell>
    <mxCell id="mkt_fail" value="KHO HẾT HÀNG (FAILURE PATH):&lt;br&gt;• Cập nhật Saga ──► FAILED&lt;br&gt;• Ghi Outbox: MarketplaceOrderStockFailedEvent&lt;br&gt;• MS-13 gọi Partner API tự động hủy đơn sàn" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#e53935;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="box_f1"><mxGeometry x="1090" y="160" width="260" height="75" as="geometry" /></mxCell>
    <mxCell id="e_f1_1" value="1. Webhook POST" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#7b1fa2;strokeWidth=1.5;endArrow=block;endFill=1;;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="mkt_ext" target="mkt_ch" parent="box_f1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset" /></mxGeometry></mxCell>
