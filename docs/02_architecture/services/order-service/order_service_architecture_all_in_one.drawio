    <mxCell id="st_completed" value="COMPLETED&lt;br&gt;&lt;i&gt;Sau 7 ngày không khiếu nại (Tích 1% Xu)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#81c784;strokeColor=#2e7d32;fontColor=#ffffff;fontStyle=1;fontSize=12.5;" vertex="1" parent="1"><mxGeometry x="920" y="780" width="260" height="75" as="geometry" /></mxCell>
    <mxCell id="end_comp" value="" style="shape=ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1240" y="802" width="30" height="30" as="geometry" /></mxCell>
    <mxCell id="box_fsm_note" value="&lt;b&gt;CÁC ĐIỀU KIỆN CHUYỂN TRẠNG THÁI VÀ BẢO VỆ CHỐNG TRANH CHẤP (CAS GUARDS):&lt;/b&gt;&lt;br&gt; • &lt;b&gt;DRAFT ──► PENDING_PAYMENT:&lt;/b&gt; Gọi đồng thời 3 gRPC thẩm tra + MS-01 &lt;code&gt;ReserveStock(order_id, ttl=15m)&lt;/code&gt; thành công.&lt;br&gt; • &lt;b&gt;PENDING_PAYMENT ──► PAID:&lt;/b&gt; Xác thực Webhook HMAC-SHA256, bắt buộc &lt;code&gt;amount == final_units&lt;/code&gt;. CAS giải quyết tranh chấp Second-899.&lt;br&gt; • &lt;b&gt;PENDING_PAYMENT ──► CANCELLED_TIMEOUT:&lt;/b&gt; Sweeper 15s quét quá giờ, tự động kích hoạt đền bù tập trung (Model A) nhả kho và voucher.&lt;br&gt; • &lt;b&gt;DELIVERED ──► COMPLETED:&lt;/b&gt; Quá 7 ngày không khiếu nại, phát sự kiện &lt;code&gt;OrderCompletedEvent&lt;/code&gt; để MS-07 tích điểm thưởng Mè Xửng Xu." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#bdbdbd;fontSize=11;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="110" y="770" width="500" height="130" as="geometry" /></mxCell>
