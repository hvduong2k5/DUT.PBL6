    <mxCell id="t2" value="&lt;b&gt;Sơ Đồ 2: Mô Hình Dữ Liệu Quan Hệ (PostgreSQL 16 Schema ERD — order_db)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=17;fontColor=#1a237e;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="150" y="12" width="950" height="35" as="geometry" /></mxCell>
    <mxCell id="tbl_items" value="order_line_items" style="swimlane;startSize=28;fillColor=#2e7d32;strokeColor=#1b5e20;fontColor=#ffffff;fontStyle=1;fontSize=13.5;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="320" height="190" as="geometry" /></mxCell>
    <mxCell id="f_items" value="&lt;b&gt;PK id&lt;/b&gt; : UUID (v7)&lt;br&gt;&lt;b&gt;FK order_id&lt;/b&gt; : UUID [IDX ON DELETE CASCADE]&lt;br&gt;sku_code : VARCHAR(64) [IDX]&lt;br&gt;product_name : VARCHAR(255)&lt;br&gt;quantity : INT (quantity &gt; 0)&lt;br&gt;unit_price_units : BIGINT&lt;br&gt;&lt;b&gt;total_price_units&lt;/b&gt; : BIGINT [CHK = unit_price * qty]&lt;br&gt;packaging_specs : VARCHAR(100) (Hộp 500g, Túi 300g)&lt;br&gt;created_at : TIMESTAMPTZ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;spacingLeft=8;spacingTop=6;" vertex="1" parent="tbl_items"><mxGeometry x="0" y="28" width="320" height="162" as="geometry" /></mxCell>
    <mxCell id="tbl_addr" value="order_address_snapshots (1:1 Snapshot)" style="swimlane;startSize=28;fillColor=#e65100;strokeColor=#bf360c;fontColor=#ffffff;fontStyle=1;fontSize=13.5;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="320" height="205" as="geometry" /></mxCell>
    <mxCell id="f_addr" value="&lt;b&gt;PK id&lt;/b&gt; : UUID (v7)&lt;br&gt;&lt;b&gt;UK/FK order_id&lt;/b&gt; : UUID (Quan hệ 1:1 với orders)&lt;br&gt;recipient_name : VARCHAR(150)&lt;br&gt;phone_number : VARCHAR(20)&lt;br&gt;street_address : VARCHAR(255)&lt;br&gt;ward_code : VARCHAR(20) | ward_name : VARCHAR(100)&lt;br&gt;province_code : VARCHAR(20) | province_name : VARCHAR(100)&lt;br&gt;latitude : NUMERIC(10, 7) | longitude : NUMERIC(10, 7)&lt;br&gt;&lt;i&gt;-- Chuẩn hóa 2 cấp hành chính (Xã/Tỉnh hậu 01/07/2025)&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;spacingLeft=8;spacingTop=6;" vertex="1" parent="tbl_addr"><mxGeometry x="0" y="28" width="320" height="177" as="geometry" /></mxCell>
    <mxCell id="tbl_voucher" value="order_voucher_snapshots" style="swimlane;startSize=28;fillColor=#512da8;strokeColor=#311b92;fontColor=#ffffff;fontStyle=1;fontSize=13.5;" vertex="1" parent="1"><mxGeometry x="40" y="515" width="320" height="160" as="geometry" /></mxCell>
    <mxCell id="f_voucher" value="&lt;b&gt;PK id&lt;/b&gt; : UUID (v7)&lt;br&gt;&lt;b&gt;UK/FK order_id&lt;/b&gt; : UUID (Quan hệ 1:0..1)&lt;br&gt;voucher_code : VARCHAR(50)&lt;br&gt;discount_type : VARCHAR(20) ('PERCENTAGE', 'FIXED')&lt;br&gt;discount_value_units : BIGINT&lt;br&gt;applied_units : BIGINT (Số tiền giảm thực tế)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;spacingLeft=8;spacingTop=6;" vertex="1" parent="tbl_voucher"><mxGeometry x="0" y="28" width="320" height="132" as="geometry" /></mxCell>
    <mxCell id="tbl_orders" value="orders (Aggregate Root)" style="swimlane;startSize=28;fillColor=#1565c0;strokeColor=#0d47a1;fontColor=#ffffff;fontStyle=1;fontSize=13.5;" vertex="1" parent="1"><mxGeometry x="455" y="60" width="340" height="305" as="geometry" /></mxCell>
    <mxCell id="f_orders" value="&lt;b&gt;PK id&lt;/b&gt; : UUID (v7 Generated by App)&lt;br&gt;&lt;b&gt;UK order_code&lt;/b&gt; : VARCHAR(32) ('ORD-YYYYMMDD-XXXX')&lt;br&gt;customer_id : UUID (FK sang MS-15, Nullable for Guest)&lt;br&gt;channel : VARCHAR(30) (D2C_WEB, POS_OFFLINE, ...)&lt;br&gt;&lt;b&gt;status&lt;/b&gt; : VARCHAR(35) (DRAFT, PENDING_PAYMENT, PAID, ...)&lt;br&gt;subtotal_units : BIGINT (VND units &gt;= 0)&lt;br&gt;discount_units : BIGINT DEFAULT 0 [CHK &amp;lt;= subtotal]&lt;br&gt;shipping_units : BIGINT DEFAULT 0&lt;br&gt;&lt;b&gt;final_units&lt;/b&gt; : BIGINT [CHK = subtotal - disc + ship]&lt;br&gt;currency : VARCHAR(3) DEFAULT 'VND'&lt;br&gt;customer_note : TEXT | staff_note : TEXT&lt;br&gt;&lt;b&gt;version&lt;/b&gt; : INT DEFAULT 1 (OCC CAS Optimistic Locking)&lt;br&gt;&lt;b&gt;expires_at&lt;/b&gt; : TIMESTAMPTZ (Hạn chót đếm ngược 15 phút)&lt;br&gt;tracking_code : VARCHAR(100) | seal_code : VARCHAR(50)&lt;br&gt;created_at : TIMESTAMPTZ | updated_at : TIMESTAMPTZ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;spacingLeft=8;spacingTop=6;" vertex="1" parent="tbl_orders"><mxGeometry x="0" y="28" width="340" height="277" as="geometry" /></mxCell>
    <mxCell id="tbl_payments" value="payments (Quan Hệ 1:N)" style="swimlane;startSize=28;fillColor=#c2185b;strokeColor=#880e4f;fontColor=#ffffff;fontStyle=1;fontSize=13.5;" vertex="1" parent="1"><mxGeometry x="455" y="415" width="340" height="220" as="geometry" /></mxCell>
    <mxCell id="f_payments" value="&lt;b&gt;PK id&lt;/b&gt; : UUID (v7)&lt;br&gt;&lt;b&gt;FK order_id&lt;/b&gt; : UUID [IDX]&lt;br&gt;payment_provider : VARCHAR(30) (VIETQR_NAPAS, COD, ...)&lt;br&gt;provider_transaction_id : VARCHAR(100)&lt;br&gt;payment_type : VARCHAR(20) ('PAYMENT', 'REFUND')&lt;br&gt;payment_status : VARCHAR(20) (PENDING, PAID, FAILED, ...)&lt;br&gt;amount_units : BIGINT (Khớp tuyệt đối amount == final)&lt;br&gt;&lt;b&gt;UK idempotency_key&lt;/b&gt; : VARCHAR(128)&lt;br&gt;raw_signature : TEXT | executed_at : TIMESTAMPTZ&lt;br&gt;&lt;i&gt;-- Chống trùng lặp giao dịch phía Ngân hàng:&lt;br&gt;&lt;b&gt;UNIQUE (payment_provider, provider_transaction_id)&lt;/b&gt;&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;spacingLeft=8;spacingTop=6;" vertex="1" parent="tbl_payments"><mxGeometry x="0" y="28" width="340" height="192" as="geometry" /></mxCell>
    <mxCell id="tbl_saga" value="saga_instances (Điều Phối Model A)" style="swimlane;startSize=28;fillColor=#00796b;strokeColor=#004d40;fontColor=#ffffff;fontStyle=1;fontSize=13.5;" vertex="1" parent="1"><mxGeometry x="890" y="60" width="320" height="205" as="geometry" /></mxCell>
    <mxCell id="f_saga" value="&lt;b&gt;PK id&lt;/b&gt; : UUID (v7)&lt;br&gt;&lt;b&gt;FK order_id&lt;/b&gt; : UUID [IDX]&lt;br&gt;saga_type : VARCHAR(50) ('CHECKOUT_D2C_SAGA', ...)&lt;br&gt;current_step : VARCHAR(50)&lt;br&gt;&lt;b&gt;status&lt;/b&gt; : VARCHAR(30) (STARTED, IN_PROGRESS,&lt;br&gt;COMPLETED, COMPENSATING, COMPENSATED, DEAD_LETTER)&lt;br&gt;payload : JSONB&lt;br&gt;retry_count : INT DEFAULT 0 (Tối đa 5 lần)&lt;br&gt;expires_at : TIMESTAMPTZ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;spacingLeft=8;spacingTop=6;" vertex="1" parent="tbl_saga"><mxGeometry x="0" y="28" width="320" height="177" as="geometry" /></mxCell>
    <mxCell id="tbl_saga_logs" value="saga_step_logs" style="swimlane;startSize=28;fillColor=#00838f;strokeColor=#006064;fontColor=#ffffff;fontStyle=1;fontSize=13.5;" vertex="1" parent="1"><mxGeometry x="890" y="295" width="320" height="175" as="geometry" /></mxCell>
    <mxCell id="f_sagalogs" value="&lt;b&gt;PK id&lt;/b&gt; : UUID (v7)&lt;br&gt;&lt;b&gt;FK saga_id&lt;/b&gt; : UUID [IDX REFERENCES saga_instances]&lt;br&gt;step_name : VARCHAR(100)&lt;br&gt;action_type : VARCHAR(30) ('COMMAND', 'COMPENSATION')&lt;br&gt;status : VARCHAR(20) ('SUCCESS', 'FAILED')&lt;br&gt;details : JSONB (Request/Response Snapshot)&lt;br&gt;created_at : TIMESTAMPTZ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;spacingLeft=8;spacingTop=6;" vertex="1" parent="tbl_saga_logs"><mxGeometry x="0" y="28" width="320" height="147" as="geometry" /></mxCell>
    <mxCell id="tbl_outbox" value="outbox_events (Transactional Outbox)" style="swimlane;startSize=28;fillColor=#455a64;strokeColor=#263238;fontColor=#ffffff;fontStyle=1;fontSize=13.5;" vertex="1" parent="1"><mxGeometry x="890" y="500" width="320" height="175" as="geometry" /></mxCell>
    <mxCell id="f_outbox" value="&lt;b&gt;PK id&lt;/b&gt; : UUID (v7)&lt;br&gt;aggregate_type : VARCHAR(50) ('ORDER')&lt;br&gt;aggregate_id : VARCHAR(100)&lt;br&gt;event_type : VARCHAR(100) (CloudEvents v1.0)&lt;br&gt;topic : VARCHAR(100) ('order.events.v1')&lt;br&gt;payload : JSONB&lt;br&gt;status : VARCHAR(20) ('PENDING', 'PUBLISHED', 'FAILED')&lt;br&gt;created_at : TIMESTAMPTZ [IDX]" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;spacingLeft=8;spacingTop=6;" vertex="1" parent="tbl_outbox"><mxGeometry x="0" y="28" width="320" height="147" as="geometry" /></mxCell>
    <mxCell id="b_note_erd" value="&lt;b&gt;NGUYÊN TẮC THIẾT KẾ CƠ SỞ DỮ LIỆU ORDER_DB (POSTGRESQL 16):&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Khóa chính UUID v7&lt;/b&gt; sinh trực tiếp từ Application Layer, tối ưu hóa triệt để B-Tree Sequential Write. • &lt;b&gt;Bảo đảm số học tuyệt đối:&lt;/b&gt; Ràng buộc Check Constraints ngăn chặn sai lệch tiền tệ VND. • &lt;b&gt;Snapshots bất biến:&lt;/b&gt; Địa chỉ giao hàng và Voucher được lưu cố định tại thời điểm checkout, bảo vệ toàn vẹn lịch sử đơn hàng." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#b0bec5;fontSize=11;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="695" width="1170" height="75" as="geometry" /></mxCell>
    <mxCell id="rel_ord_items" value="1-N chi tiết" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#1565c0;strokeWidth=1.5;endArrow=block;endFill=1;;exitX=0;exitY=0.25;exitDx=0;exitDy=0;entryX=1;entryY=0.35;entryDx=0;entryDy=0;" edge="1" source="tbl_orders" target="tbl_items" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset" /></mxGeometry></mxCell>
    <mxCell id="rel_ord_addr" value="1-1 địa chỉ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#e65100;strokeWidth=1.5;endArrow=block;endFill=1;;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.35;entryDx=0;entryDy=0;" edge="1" source="tbl_orders" target="tbl_addr" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset" /></mxGeometry></mxCell>
    <mxCell id="rel_ord_vouch" value="1-0..1 voucher" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#512da8;strokeWidth=1.5;endArrow=block;endFill=1;;exitX=0;exitY=0.95;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="tbl_orders" target="tbl_voucher" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="405" y="350" /><mxPoint x="405" y="595" /></Array><mxPoint x="-35" y="0" as="offset" /></mxGeometry></mxCell>
    <mxCell id="rel_ord_pay" value="1-N thanh toán" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#c2185b;strokeWidth=1.5;endArrow=block;endFill=1;;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="tbl_orders" target="tbl_payments" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="48" y="0" as="offset" /></mxGeometry></mxCell>
    <mxCell id="rel_ord_saga" value="1-N Saga" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#00796b;strokeWidth=1.5;endArrow=block;endFill=1;;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" source="tbl_orders" target="tbl_saga" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset" /></mxGeometry></mxCell>
    <mxCell id="rel_saga_logs" value="1-N lịch sử bước" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#00838f;strokeWidth=1.5;endArrow=block;endFill=1;;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="tbl_saga" target="tbl_saga_logs" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="48" y="0" as="offset" /></mxGeometry></mxCell>
  </root>
</mxGraphModel></diagram><diagram name="03. Domain Aggregate Model"><mxGraphModel dx="1220" dy="860" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1220" pageHeight="860" math="0" shadow="0">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />
    <mxCell id="t3" value="&lt;b&gt;Sơ Đồ 3: Mô Hình Miền Nghiệp Vụ &amp;amp; Các Bất Biến (Domain Model &amp;amp; DDD Invariants)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=17;fontColor=#1a237e;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="150" y="15" width="950" height="35" as="geometry" /></mxCell>
    <mxCell id="cls_addr" value="AddressSnapshot «Value Object»" style="swimlane;startSize=28;fillColor=#00796b;strokeColor=#004d40;fontColor=#ffffff;fontStyle=1;fontSize=13.5;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="300" height="175" as="geometry" /></mxCell>
    <mxCell id="f_cls_addr" value="+ string recipientName&lt;br&gt;+ string phoneNumber&lt;br&gt;+ string streetAddress&lt;br&gt;+ string wardCode, wardName&lt;br&gt;+ string provinceCode, provinceName&lt;br&gt;+ decimal latitude, longitude&lt;hr&gt;&lt;i&gt;-- Chuẩn 2 cấp hành chính (Xã/Tỉnh)&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;spacingLeft=8;spacingTop=6;" vertex="1" parent="cls_addr"><mxGeometry x="0" y="28" width="300" height="147" as="geometry" /></mxCell>
    <mxCell id="cls_vouch" value="VoucherSnapshot «Value Object»" style="swimlane;startSize=28;fillColor=#512da8;strokeColor=#311b92;fontColor=#ffffff;fontStyle=1;fontSize=13.5;" vertex="1" parent="1"><mxGeometry x="40" y="275" width="300" height="145" as="geometry" /></mxCell>
    <mxCell id="f_cls_vouch" value="+ string voucherCode&lt;br&gt;+ string discountType ('PERCENTAGE', 'FIXED')&lt;br&gt;+ Money discountValue&lt;br&gt;+ Money appliedAmount" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;spacingLeft=8;spacingTop=6;" vertex="1" parent="cls_vouch"><mxGeometry x="0" y="28" width="300" height="117" as="geometry" /></mxCell>
    <mxCell id="cls_order" value="Order (Aggregate Root)" style="swimlane;startSize=28;fillColor=#1565c0;strokeColor=#0d47a1;fontColor=#ffffff;fontStyle=1;fontSize=13.5;" vertex="1" parent="1"><mxGeometry x="430" y="65" width="340" height="360" as="geometry" /></mxCell>
    <mxCell id="f_cls_order" value="+ UUID id&lt;br&gt;+ OrderCode orderCode&lt;br&gt;+ UUID customerId (Nullable for Guest)&lt;br&gt;+ Channel channel&lt;br&gt;+ OrderStatus status&lt;br&gt;+ Money subtotalAmount&lt;br&gt;+ Money discountAmount&lt;br&gt;+ Money shippingFee&lt;br&gt;+ Money finalAmount&lt;br&gt;+ AddressSnapshot shippingAddress&lt;br&gt;+ VoucherSnapshot appliedVoucher&lt;br&gt;+ List&amp;lt;OrderLineItem&amp;gt; items&lt;br&gt;+ List&amp;lt;PaymentTransaction&amp;gt; payments&lt;br&gt;+ int version (CAS Optimistic Locking)&lt;br&gt;+ DateTime createdAt, updatedAt&lt;hr&gt;+ addOrderItem(item)&lt;br&gt;+ applyVoucher(voucher)&lt;br&gt;+ markPendingPayment()&lt;br&gt;+ markPaid(transactionId, amount, provider)&lt;br&gt;+ cancel(reason)&lt;br&gt;+ calculateTotals()" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;spacingLeft=8;spacingTop=6;" vertex="1" parent="cls_order"><mxGeometry x="0" y="28" width="340" height="332" as="geometry" /></mxCell>
    <mxCell id="cls_pay" value="PaymentTransaction (Entity)" style="swimlane;startSize=28;fillColor=#c2185b;strokeColor=#880e4f;fontColor=#ffffff;fontStyle=1;fontSize=13.5;" vertex="1" parent="1"><mxGeometry x="430" y="465" width="340" height="190" as="geometry" /></mxCell>
    <mxCell id="f_cls_pay" value="+ UUID id&lt;br&gt;+ PaymentProvider provider&lt;br&gt;+ string providerTransactionId&lt;br&gt;+ PaymentMethod method&lt;br&gt;+ PaymentTransactionType type (PAYMENT, REFUND)&lt;br&gt;+ PaymentStatus status (PENDING, PAID, FAILED)&lt;br&gt;+ Money amount&lt;br&gt;+ string rawSignature&lt;br&gt;+ DateTime executedAt" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;spacingLeft=8;spacingTop=6;" vertex="1" parent="cls_pay"><mxGeometry x="0" y="28" width="340" height="162" as="geometry" /></mxCell>
    <mxCell id="cls_item" value="OrderLineItem (Entity)" style="swimlane;startSize=28;fillColor=#2e7d32;strokeColor=#1b5e20;fontColor=#ffffff;fontStyle=1;fontSize=13.5;" vertex="1" parent="1"><mxGeometry x="860" y="65" width="310" height="175" as="geometry" /></mxCell>
    <mxCell id="f_cls_item" value="+ UUID id&lt;br&gt;+ string skuCode&lt;br&gt;+ string productName&lt;br&gt;+ int quantity (&amp;gt; 0)&lt;br&gt;+ Money unitPrice&lt;br&gt;+ Money totalPrice (= unitPrice * quantity)&lt;br&gt;+ string packagingSpecs&lt;br&gt;+ string itemNotes" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;spacingLeft=8;spacingTop=6;" vertex="1" parent="cls_item"><mxGeometry x="0" y="28" width="310" height="147" as="geometry" /></mxCell>
    <mxCell id="cls_money" value="Money «Value Object»" style="swimlane;startSize=28;fillColor=#f57c00;strokeColor=#e65100;fontColor=#ffffff;fontStyle=1;fontSize=13.5;" vertex="1" parent="1"><mxGeometry x="860" y="275" width="310" height="145" as="geometry" /></mxCell>
    <mxCell id="f_cls_money" value="+ int64 amount (VND units, cấm float)&lt;br&gt;+ string currency = 'VND'&lt;hr&gt;+ add(Money) Money&lt;br&gt;+ subtract(Money) Money&lt;br&gt;+ multiply(int) Money&lt;br&gt;+ equals(Money) bool" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;spacingLeft=8;spacingTop=6;" vertex="1" parent="cls_money"><mxGeometry x="0" y="28" width="310" height="117" as="geometry" /></mxCell>
    <mxCell id="box_invariants" value="&lt;b&gt;CÁC BẤT BIẾN NGHIỆP VỤ MIỀN (DOMAIN INVARIANTS):&lt;/b&gt;&lt;br&gt;&lt;br&gt; 1. &lt;b&gt;Bất Biến Chiết Khấu (Discount Invariant):&lt;/b&gt; &lt;code&gt;discount_units &amp;lt;= subtotal_units&lt;/code&gt;. Chiết khấu khuyến mãi không bao giờ vượt quá tổng giá trị hàng hóa.&lt;br&gt; 2. &lt;b&gt;Bất Biến Toàn Vẹn Số Học (Math Integrity Invariant):&lt;/b&gt; &lt;code&gt;final_units = subtotal_units - discount_units + shipping_units&lt;/code&gt;. Tuyệt đối không có sai số làm tròn nhờ kiểu &lt;code&gt;int64&lt;/code&gt;.&lt;br&gt; 3. &lt;b&gt;Bất Biến Sàn Thanh Toán (Payment Floor Invariant):&lt;/b&gt; &lt;code&gt;final_units &amp;gt;= shipping_units&lt;/code&gt;. Khách hàng bắt buộc phải trả tối thiểu bằng phí vận chuyển.&lt;br&gt; 4. &lt;b&gt;Bất Biến Khớp Tiền Tuyệt Đối (Exact Match Invariant):&lt;/b&gt; Chỉ chuyển &lt;code&gt;PAID&lt;/code&gt; khi &lt;code&gt;amount_paid == final_units&lt;/code&gt;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#b0bec5;fontSize=11.5;align=left;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="685" width="1130" height="160" as="geometry" /></mxCell>
    <mxCell id="e_ord_addr" value="1..1 địa chỉ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#00796b;strokeWidth=1.5;endArrow=block;endFill=1;;exitX=0;exitY=0.25;exitDx=0;exitDy=0;entryX=1;entryY=0.45;entryDx=0;entryDy=0;" edge="1" source="cls_order" target="cls_addr" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset" /></mxGeometry></mxCell>
    <mxCell id="e_ord_vouch" value="0..1 voucher" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#512da8;strokeWidth=1.5;endArrow=block;endFill=1;;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.45;entryDx=0;entryDy=0;" edge="1" source="cls_order" target="cls_vouch" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset" /></mxGeometry></mxCell>
    <mxCell id="e_ord_pay" value="0..* records" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#c2185b;strokeWidth=1.5;endArrow=block;endFill=1;;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="cls_order" target="cls_pay" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="0" as="offset" /></mxGeometry></mxCell>
    <mxCell id="e_ord_item" value="1..* contains" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#2e7d32;strokeWidth=1.5;endArrow=block;endFill=1;;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.45;entryDx=0;entryDy=0;" edge="1" source="cls_order" target="cls_item" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset" /></mxGeometry></mxCell>
    <mxCell id="e_item_money" value="priced in" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#f57c00;strokeWidth=1.5;endArrow=block;endFill=1;;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="cls_item" target="cls_money" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="35" y="0" as="offset" /></mxGeometry></mxCell>
  </root>
</mxGraphModel></diagram><diagram name="04. Order Lifecycle FSM"><mxGraphModel dx="1340" dy="920" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1340" pageHeight="920" math="0" shadow="0">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />
    <mxCell id="t4" value="&lt;b&gt;Sơ Đồ 4: Máy Trạng Thái Đơn Hàng Hoàn Chỉnh (Order State Machine FSM — 14 States)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=17;fontColor=#1a237e;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="250" y="15" width="950" height="35" as="geometry" /></mxCell>
    <mxCell id="start" value="" style="shape=ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="195" width="30" height="30" as="geometry" /></mxCell>
    <mxCell id="st_draft" value="DRAFT&lt;br&gt;&lt;i&gt;Khởi tạo phiên Checkout D2C&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontStyle=1;fontSize=12.5;" vertex="1" parent="1"><mxGeometry x="110" y="170" width="250" height="80" as="geometry" /></mxCell>
