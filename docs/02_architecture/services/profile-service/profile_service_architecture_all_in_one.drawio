  <diagram id="tab_6" name="6. Checkout gRPC SLA P99">
    <mxGraphModel dx="1630" dy="880" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1630" pageHeight="880" math="0" shadow="0">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="t6" value="&lt;b&gt;Sơ Đồ 6: Luồng Lấy Địa Chỉ Checkout gRPC &amp;amp; Bộ Đệm 2 Tầng (Critical Path SLA P99 ≤ 5ms)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=17;fontColor=#1a237e;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="15" width="950" height="35" as="geometry"/></mxCell>
    <mxCell id="ll_cust" value="&lt;b&gt;Khách Hàng (D2C)&lt;br&gt;Web / Mobile App&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#0288d1;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=12.5;fontStyle=1;size=38;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="170" height="715" as="geometry"/></mxCell>
    <mxCell id="ll_order" value="&lt;b&gt;MS-04: order-service&lt;br&gt;(Checkout Saga)&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#1565c0;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=12.5;fontStyle=1;size=38;" vertex="1" parent="1"><mxGeometry x="280" y="65" width="180" height="715" as="geometry"/></mxCell>
    <mxCell id="ll_prof" value="&lt;b&gt;MS-15: profile-service&lt;br&gt;(gRPC Server)&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#00796b;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=12.5;fontStyle=1;size=38;" vertex="1" parent="1"><mxGeometry x="520" y="65" width="190" height="715" as="geometry"/></mxCell>
    <mxCell id="ll_l1" value="&lt;b&gt;Tầng 1: L1 LRU Cache&lt;br&gt;(RAM 421.9 ns/op)&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f57c00;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=12.5;fontStyle=1;size=38;" vertex="1" parent="1"><mxGeometry x="860" y="65" width="180" height="715" as="geometry"/></mxCell>
    <mxCell id="ll_l2" value="&lt;b&gt;Tầng 2: L2 Redis Cache&lt;br&gt;(TCP 0.8ms - 1.2ms)&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#c2185b;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=12.5;fontStyle=1;size=38;" vertex="1" parent="1"><mxGeometry x="1120" y="65" width="180" height="715" as="geometry"/></mxCell>
    <mxCell id="ll_db" value="&lt;b&gt;PostgreSQL 16 Database&lt;br&gt;(B-Tree 2.0ms - 3.5ms)&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#303f9f;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=12.5;fontStyle=1;size=38;" vertex="1" parent="1"><mxGeometry x="1380" y="65" width="190" height="715" as="geometry"/></mxCell>
    <mxCell id="m1" value="1. POST /checkout (JWT, CartItems, AddressID)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#0288d1;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.090;entryX=0.5;entryY=0.090;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_cust" target="ll_order" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell>
    <mxCell id="m2" value="2. gRPC GetDeliveryAddress(address_id, customer_id)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#1565c0;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.150;entryX=0.5;entryY=0.150;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_order" target="ll_prof" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell>
    <mxCell id="m3" value="3. lru.Get(profile:addr:{id})" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#f57c00;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.210;entryX=0.5;entryY=0.210;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_prof" target="ll_l1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell>
    <mxCell id="box_l1_hit" value="&lt;b&gt;TRƯỜNG HỢP 1: L1 CACHE HIT&lt;/b&gt;&lt;br&gt;421.9 ns/op — Trả kết quả tức thì" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#e8f5e9;strokeColor=#4caf50;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="685" y="235" width="200" height="42" as="geometry"/></mxCell>
    <mxCell id="m4" value="4a. [L1 Hit] Return DeliveryAddress (0.0004 ms)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#2e7d32;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;exitX=0.5;exitY=0.320;entryX=0.5;entryY=0.320;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_l1" target="ll_prof" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell>
    <mxCell id="box_l2_hit" value="&lt;b&gt;TRƯỜNG HỢP 2: L1 MISS&lt;/b&gt;&lt;br&gt;Truy vấn L2 Redis TCP Pool" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9c4;strokeColor=#fbc02d;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="685" y="330" width="200" height="42" as="geometry"/></mxCell>
    <mxCell id="m5" value="5. GET profile:addr:{id} qua Redis TCP Pool" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#c2185b;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.460;entryX=0.5;entryY=0.460;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_prof" target="ll_l2" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell>
    <mxCell id="m6" value="6a. [L2 Hit] Return JSON (0.95 ms) ──► Backfill L1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#2e7d32;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;exitX=0.5;exitY=0.530;entryX=0.5;entryY=0.530;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_l2" target="ll_prof" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell>
    <mxCell id="box_db_hit" value="&lt;b&gt;TRƯỜNG HỢP 3: L2 MISS&lt;/b&gt;&lt;br&gt;Fallback PostgreSQL 16 DB" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffe0b2;strokeColor=#f57c00;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="685" y="470" width="200" height="42" as="geometry"/></mxCell>
    <mxCell id="m7" value="7. SELECT * FROM shipping_addresses WHERE id = ? (B-Tree Index)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#303f9f;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.650;entryX=0.5;entryY=0.650;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_prof" target="ll_db" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell>
    <mxCell id="m8" value="8. Return Row (2.5 ms) ──► Backfill L2 (TTL 30m) &amp;amp; L1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#303f9f;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;exitX=0.5;exitY=0.720;entryX=0.5;entryY=0.720;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_db" target="ll_prof" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell>
