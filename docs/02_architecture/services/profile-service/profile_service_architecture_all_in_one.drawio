    <mxCell id="m5" value="5. POST /orders/claim/verify (OTP 6 số)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#0288d1;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.380;entryX=0.5;entryY=0.380;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_cust" target="ll_prof" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell>
    <mxCell id="m6" value="6. BEGIN TX: Check OTP &amp;amp; Partial Index -&gt; SET CLAIMED" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#1565c0;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.440;entryX=0.5;entryY=0.440;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_prof" target="ll_db" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell>
    <mxCell id="m7" value="7. INSERT INTO outbox_events (GuestOrderClaimedEvent) -&gt; COMMIT TX" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#1565c0;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.500;entryX=0.5;entryY=0.500;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_prof" target="ll_db" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell>
    <mxCell id="m8" value="8. HTTP 200 OK: Đã liên kết đơn hàng thành công!" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#0288d1;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.560;entryX=0.5;entryY=0.560;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_prof" target="ll_cust" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell>
    <mxCell id="m9" value="9. Polling: SELECT ... FOR UPDATE SKIP LOCKED (500ms)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#f57c00;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.640;entryX=0.5;entryY=0.640;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_wrk" target="ll_db" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell>
    <mxCell id="m10" value="10. Trả về mảng sự kiện chưa xuất bản" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#1565c0;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;exitX=0.5;exitY=0.700;entryX=0.5;entryY=0.700;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_db" target="ll_wrk" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell>
    <mxCell id="m11" value="11. Publish GuestOrderClaimedEvent (topic: guest.order.events.v1)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#2e7d32;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.760;entryX=0.5;entryY=0.760;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_wrk" target="ll_kfk" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell>
    <mxCell id="m12" value="12. UPDATE outbox_events SET published_at = NOW()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#f57c00;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.820;entryX=0.5;entryY=0.820;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_wrk" target="ll_db" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell>
    <mxCell id="m13" value="13. Consume: Gắn customer_id vào đơn cũ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#2e7d32;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;exitX=0.5;exitY=0.880;entryX=0.5;entryY=0.880;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_kfk" target="ll_order" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell>
    <mxCell id="m14" value="14. Consume: Cộng điểm thưởng Mè Xửng Xu" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#2e7d32;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;exitX=0.5;exitY=0.940;entryX=0.5;entryY=0.940;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_kfk" target="ll_promo" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell>
  </root>
</mxGraphModel>
  </diagram>
  <diagram id="tab_9" name="9. Cache Invalidation Flow">
    <mxGraphModel dx="1540" dy="750" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1540" pageHeight="750" math="0" shadow="0">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="t9" value="&lt;b&gt;Sơ Đồ 9: Kiến Trúc Bộ Đệm 2 Tầng &amp;amp; Cơ Chế Đồng Bộ Xóa Cache (Dual-Layer Cache Invalidation)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=17;fontColor=#1a237e;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="15" width="850" height="35" as="geometry"/></mxCell>
    <mxCell id="pod_a" value="PROFILE-SERVICE REPLICA: POD A" style="swimlane;startSize=28;fillColor=#e3f2fd;strokeColor=#1e88e5;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="50" y="60" width="350" height="510" as="geometry"/></mxCell>
    <mxCell id="a_req" value="Write Request: UpdateProfile()&lt;br&gt;&lt;i&gt;(Khách cập nhật Họ tên / Đổi địa chỉ)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11.5;fontStyle=1;" vertex="1" parent="pod_a"><mxGeometry x="20" y="42" width="310" height="52" as="geometry"/></mxCell>
    <mxCell id="a_app" value="Application Engine (OCC CAS)&lt;br&gt;&lt;i&gt;Thực thi UPDATE PostgreSQL 16 (version+1)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11.5;fontStyle=1;" vertex="1" parent="pod_a"><mxGeometry x="20" y="126" width="310" height="52" as="geometry"/></mxCell>
    <mxCell id="a_l1" value="Tầng 1: L1 In-Memory LRU Cache&lt;br&gt;&lt;i&gt;Gọi: lru.Remove(profile:cust:{id})&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#fb8c00;fontStyle=1;fontSize=11.5;" vertex="1" parent="pod_a"><mxGeometry x="20" y="218" width="310" height="58" as="geometry"/></mxCell>
    <mxCell id="a_sync" value="Redis Invalidation Publisher&lt;br&gt;&lt;i&gt;Gửi lệnh DEL L2 + PUBLISH channel&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcdd2;strokeColor=#e53935;fontStyle=1;fontSize=11.5;" vertex="1" parent="pod_a"><mxGeometry x="20" y="316" width="310" height="58" as="geometry"/></mxCell>
    <mxCell id="a_note" value="&lt;b&gt;Trạng thái Pod A:&lt;/b&gt;&lt;br&gt;• L1 Pod A: Đã bị xóa (Evicted)&lt;br&gt;• Nhất quán 100% với PostgreSQL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="pod_a"><mxGeometry x="20" y="414" width="310" height="68" as="geometry"/></mxCell>
    <mxCell id="box_redis" value="REDIS 7 CLUSTER (SHARED DISTRIBUTED INFRASTRUCTURE)" style="swimlane;startSize=28;fillColor=#ffebee;strokeColor=#c62828;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="530" y="140" width="440" height="430" as="geometry"/></mxCell>
    <mxCell id="r_l2" value="Tầng 2: Distributed L2 Cache Storage&lt;br&gt;&lt;i&gt;Key: profile:cust:{id} ──► BỊ XÓA (DEL)&lt;/i&gt;&lt;br&gt;&lt;i&gt;Key: profile:addr:default:{id} ──► BỊ XÓA (DEL)&lt;/i&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#c62828;fontColor=#ffffff;fontSize=11.5;fontStyle=1;" vertex="1" parent="box_redis"><mxGeometry x="30" y="48" width="380" height="100" as="geometry"/></mxCell>
    <mxCell id="r_pubsub" value="Kênh Pub/Sub: cache:invalidate:profile&lt;br&gt;&lt;i&gt;Broadcast thông điệp xóa cache L1 tới tất cả Pods:&lt;/i&gt;&lt;br&gt;&lt;code&gt;{&quot;entity&quot;: &quot;profile&quot;, &quot;key&quot;: &quot;profile:cust:123&quot;}&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c62828;fontStyle=1;fontSize=11.5;" vertex="1" parent="box_redis"><mxGeometry x="30" y="185" width="380" height="80" as="geometry"/></mxCell>
    <mxCell id="r_stats" value="&lt;b&gt;Hiệu năng L2 Redis:&lt;/b&gt;&lt;br&gt;• Tốc độ đọc qua mạng TCP: 0.8 ms - 1.2 ms&lt;br&gt;• TTL: 15 phút (Hồ sơ), 30 phút (Địa chỉ mặc định)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="box_redis"><mxGeometry x="30" y="298" width="380" height="95" as="geometry"/></mxCell>
    <mxCell id="pod_b" value="PROFILE-SERVICE REPLICA: POD B (HOẶC POD C)" style="swimlane;startSize=28;fillColor=#e3f2fd;strokeColor=#1e88e5;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1100" y="60" width="350" height="510" as="geometry"/></mxCell>
    <mxCell id="b_sub" value="Redis Pub/Sub Subscriber Daemon&lt;br&gt;&lt;i&gt;(Lắng nghe kênh: cache:invalidate:profile)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcdd2;strokeColor=#e53935;fontStyle=1;fontSize=11.5;" vertex="1" parent="pod_b"><mxGeometry x="20" y="42" width="310" height="52" as="geometry"/></mxCell>
    <mxCell id="b_l1" value="Tầng 1: L1 In-Memory LRU Cache&lt;br&gt;&lt;i&gt;Nhận thông điệp ──► Lập tức lru.Remove(key)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#fb8c00;fontStyle=1;fontSize=11.5;" vertex="1" parent="pod_b"><mxGeometry x="20" y="130" width="310" height="65" as="geometry"/></mxCell>
    <mxCell id="b_read" value="Subsequent Read Request (gRPC Checkout)&lt;br&gt;&lt;i&gt;1. Check L1: MISS (đã xóa sạch)&lt;br&gt;2. Check L2: MISS ──► Đọc PostgreSQL 16 mới nhất&lt;br&gt;3. Backfill dữ liệu mới lên L2 và L1&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="pod_b"><mxGeometry x="20" y="225" width="310" height="105" as="geometry"/></mxCell>
    <mxCell id="b_guar" value="&lt;b&gt;Bảo Đảm Tuyệt Đối:&lt;/b&gt;&lt;br&gt;• Triệt tiêu hoàn toàn rủi ro Stale Data giữa các Pod&lt;br&gt;• Ngân sách độ trễ toàn trình vẫn đạt P99 ≤ 5ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="pod_b"><mxGeometry x="20" y="414" width="310" height="68" as="geometry"/></mxCell>
    <mxCell id="db_pg_bottom" value="PostgreSQL 16 Primary Database (profile_db) — B-Tree Index (2.5ms)" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#1565c0;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="630" width="660" height="75" as="geometry"/></mxCell>
    <mxCell id="e_a_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#1e88e5;strokeWidth=1.5;endArrow=block;endFill=1;;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="a_req" target="a_app" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="e_a_2" value="Xóa L1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#fb8c00;strokeWidth=1.5;endArrow=block;endFill=1;;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="a_app" target="a_l1" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="e_a_3" value="Trigger Sync" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#e53935;strokeWidth=1.5;endArrow=block;endFill=1;;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="a_l1" target="a_sync" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="e_a_db" value="UPDATE Commit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#1565c0;strokeWidth=1.5;endArrow=block;endFill=1;;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.1;entryY=0;entryDx=0;entryDy=0;" edge="1" source="a_app" target="db_pg_bottom" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="20" y="212"/><mxPoint x="20" y="600"/><mxPoint x="486" y="600"/></Array><mxPoint x="15" y="-16" as="offset"/></mxGeometry></mxCell>
    <mxCell id="e_a_del" value="DEL L2 Cache Key" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#c62828;strokeWidth=1.5;endArrow=block;endFill=1;;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="a_sync" target="r_l2" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell>
    <mxCell id="e_a_pub" value="PUBLISH cache:invalidate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#c62828;strokeWidth=1.5;endArrow=block;endFill=1;;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="a_sync" target="r_pubsub" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell>
    <mxCell id="e_sub_b" value="Broadcast Event" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#e53935;strokeWidth=1.5;endArrow=block;endFill=1;;dashed=1;dashPattern=6 3;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="r_pubsub" target="b_sub" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1035" y="365"/><mxPoint x="1035" y="128"/></Array><mxPoint x="15" y="-14" as="offset"/></mxGeometry></mxCell>
    <mxCell id="e_b_evict" value="lru.Remove(key)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#fb8c00;strokeWidth=1.5;endArrow=block;endFill=1;;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="b_sub" target="b_l1" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="e_b_read" value="L1 Miss" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#1e88e5;strokeWidth=1.5;endArrow=block;endFill=1;;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="b_l1" target="b_read" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="e_b_db" value="DB Query Fallback" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#1565c0;strokeWidth=1.5;endArrow=block;endFill=1;;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;" edge="1" source="b_read" target="db_pg_bottom" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1485" y="337"/><mxPoint x="1485" y="600"/><mxPoint x="1014" y="600"/></Array><mxPoint x="-25" y="-16" as="offset"/></mxGeometry></mxCell>
  </root>
</mxGraphModel>
  </diagram>
