  <diagram id="tab_5" name="5. Food Safety FSM">
    <mxGraphModel dx="1600" dy="715" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="715" math="0" shadow="0">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="t5" value="&lt;b&gt;Sơ Đồ 5: Máy Trạng Thái Tuân Thủ VSATTP Nhân Sự Xưởng Kẹo (Food Safety Compliance FSM)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=17;fontColor=#1a237e;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="20" width="850" height="35" as="geometry"/></mxCell>
    <mxCell id="start" value="" style="shape=ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="205" width="30" height="30" as="geometry"/></mxCell>
    <mxCell id="st_valid" value="VALID (ĐẠT CHUẨN OCOP)&lt;br&gt;&lt;i&gt;Cấp mới chứng chỉ VSATTP&lt;br&gt;(Thời hạn hiệu lực: 3 năm)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;fontStyle=1;fontSize=12.5;" vertex="1" parent="1"><mxGeometry x="110" y="180" width="250" height="80" as="geometry"/></mxCell>
    <mxCell id="st_warn30" value="WARNING_30D&lt;br&gt;&lt;i&gt;Cảnh báo trước 30 ngày&lt;br&gt;(Cron Checker 24h quét)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#fbc02d;fontStyle=1;fontSize=12.5;" vertex="1" parent="1"><mxGeometry x="500" y="180" width="240" height="80" as="geometry"/></mxCell>
    <mxCell id="st_crit7" value="CRITICAL_7D&lt;br&gt;&lt;i&gt;Khẩn cấp trước 7 ngày&lt;br&gt;(Gửi Email Quản đốc xưởng)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#f57c00;fontStyle=1;fontSize=12.5;" vertex="1" parent="1"><mxGeometry x="890" y="180" width="240" height="80" as="geometry"/></mxCell>
    <mxCell id="st_expired" value="RESTRICTED_EXPIRED&lt;br&gt;&lt;i&gt;Hết hạn chứng chỉ VSATTP&lt;br&gt;(Treo quyền vào ca quấy kẹo)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcdd2;strokeColor=#d32f2f;fontStyle=1;fontSize=12.5;" vertex="1" parent="1"><mxGeometry x="1280" y="180" width="250" height="80" as="geometry"/></mxCell>
    <mxCell id="b_vsattp_notes" value="&lt;b&gt;QUY TRÌNH GIÁM SÁT TUÂN THỦ AN TOÀN VỆ SINH THỰC PHẨM (OCOP HUẾ):&lt;/b&gt;&lt;br&gt;
• &lt;b&gt;Cron Worker Tự Động (01:00 AM Hàng Ngày)&lt;/b&gt;: Quét bảng &lt;code&gt;employee_profiles&lt;/code&gt; đối chiếu &lt;code&gt;food_safety_cert_expiry - CURRENT_DATE&lt;/code&gt;.&lt;br&gt;
• &lt;b&gt;Mốc 30 Ngày (WARNING_30D)&lt;/b&gt;: Gửi thông báo nhắc nhở nhân sự đăng ký lớp tập huấn kiến thức VSATTP định kỳ.&lt;br&gt;
• &lt;b&gt;Mốc 7 Ngày (CRITICAL_7D)&lt;/b&gt;: Phát cảnh báo mức độ cao tới Quản đốc xưởng sản xuất để sắp xếp nhân sự dự phòng thay thế ca trực.&lt;br&gt;
• &lt;b&gt;Mốc Hết Hạn (RESTRICTED_EXPIRED)&lt;/b&gt;: Hệ thống tự động tước quyền thao tác trên máy chấm công xưởng quấy kẹo &amp;amp; niêm phong tem QR OCOP." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#bdbdbd;align=left;fontSize=11.5;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="110" y="540" width="1420" height="135" as="geometry"/></mxCell>
    <mxCell id="e_v_start" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="start" target="st_valid" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="e_v_w30" value="Còn ≤ 30 ngày" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#fbc02d;strokeWidth=1.5;endArrow=block;endFill=1;;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="st_valid" target="st_warn30" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell>
