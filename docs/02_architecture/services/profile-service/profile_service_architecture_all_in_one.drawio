    <mxCell id="m6" value="6. Trả về: {plaintext_dek, ciphertext_dek, kek_version}" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#4a148c;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;exitX=0.5;exitY=0.430;entryX=0.5;entryY=0.430;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_vault" target="ll_prof" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell>
    <mxCell id="m7" value="7. Sinh 12-byte Nonce + Mã hóa AES-256-GCM(CCCD)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#00796b;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.500;entryX=0.5;entryY=0.500;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_prof" target="ll_prof" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="35" y="-12" as="offset"/></mxGeometry></mxCell>
    <mxCell id="m8" value="8. memguard.Zeroize(plaintext_dek) ──► Xóa sạch RAM!" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#d32f2f;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.570;entryX=0.5;entryY=0.570;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_prof" target="ll_prof" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="35" y="-12" as="offset"/></mxGeometry></mxCell>
