    <mxCell id="lbl_zeroize_note" value="&lt;b&gt;TUÂN THỦ NGHỊ ĐỊNH 13/2023/NĐ-CP VỀ BẢO VỆ DỮ LIỆU CÁ NHÂN:&lt;/b&gt;&lt;br&gt;Plaintext CCCD tuyệt đối không bao giờ chạm ổ đĩa (Disk) hay Log. DEK bị xóa sạch khỏi RAM ngay sau khi mã hóa!" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#e57373;fontSize=11.5;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="290" y="720" width="960" height="42" as="geometry"/></mxCell>
