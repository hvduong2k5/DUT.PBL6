    <mxCell id="m2" value="2. Verify JWT &amp;amp; Role HR_ADMIN (Cached JWKS)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#ff8f00;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0.160;entryX=0.5;entryY=0.160;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" source="ll_kong" target="ll_kong" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="35" y="-12" as="offset"/></mxGeometry></mxCell>
