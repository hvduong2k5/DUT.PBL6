  <diagram id="tab_3" name="3. Customer Profile FSM">
    <mxGraphModel dx="1360" dy="730" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="730" math="0" shadow="0">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="t3" value="&lt;b&gt;Sơ Đồ 3: Máy Trạng Thái Hồ Sơ Khách Hàng (Customer Profile Lifecycle FSM)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=17;fontColor=#1a237e;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="20" width="850" height="35" as="geometry"/></mxCell>
    <mxCell id="start" value="" style="shape=ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="205" width="30" height="30" as="geometry"/></mxCell>
    <mxCell id="st_pending" value="PENDING_VERIFICATION&lt;br&gt;&lt;i&gt;Đăng ký mới từ MS-16 (Thiếu Họ tên / SĐT)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#fbc02d;fontStyle=1;fontSize=12.5;" vertex="1" parent="1"><mxGeometry x="110" y="180" width="270" height="80" as="geometry"/></mxCell>
    <mxCell id="st_active" value="ACTIVE&lt;br&gt;&lt;i&gt;Hồ sơ hợp lệ, sẵn sàng đặt hàng &amp;amp; tích lũy Xu&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;fontStyle=1;fontSize=12.5;" vertex="1" parent="1"><mxGeometry x="550" y="180" width="280" height="80" as="geometry"/></mxCell>
    <mxCell id="st_suspended" value="SUSPENDED&lt;br&gt;&lt;i&gt;Quản trị viên khóa (Gian lận / Vi phạm chính sách)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcdd2;strokeColor=#d32f2f;fontStyle=1;fontSize=12.5;" vertex="1" parent="1"><mxGeometry x="1000" y="180" width="280" height="80" as="geometry"/></mxCell>
    <mxCell id="st_deleted" value="DELETED (Soft Delete)&lt;br&gt;&lt;i&gt;Quyền được lãng quên (Right to be Forgotten - NĐ 13/2023)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfd8dc;strokeColor=#455a64;fontStyle=1;fontSize=12.5;" vertex="1" parent="1"><mxGeometry x="550" y="370" width="280" height="80" as="geometry"/></mxCell>
    <mxCell id="end_term" value="" style="shape=ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="675" y="495" width="30" height="30" as="geometry"/></mxCell>
    <mxCell id="b_notes" value="&lt;b&gt;QUY TẮC CHUYỂN TRẠNG THÁI &amp;amp; SIDE EFFECTS:&lt;/b&gt;&lt;br&gt;
• &lt;b&gt;PENDING ──► ACTIVE&lt;/b&gt;: Khách hàng cập nhật Họ tên &amp;amp; SĐT qua &lt;code&gt;UpdateProfileWithOCCUseCase&lt;/code&gt; (CAS version+1).&lt;br&gt;
• &lt;b&gt;ACTIVE ──► SUSPENDED&lt;/b&gt;: Quản trị viên kích hoạt khóa tài khoản; ngay lập tức thu hồi mọi phiên đăng nhập qua Redis Pub/Sub.&lt;br&gt;
• &lt;b&gt;SUSPENDED ──► ACTIVE&lt;/b&gt;: Mở khóa sau khi xác minh danh tính; khôi phục quyền truy cập API.&lt;br&gt;
• &lt;b&gt;ACTIVE ──► DELETED&lt;/b&gt;: Soft delete (&lt;code&gt;is_deleted = true&lt;/code&gt;); ẩn toàn bộ địa chỉ giao hàng; bảo toàn lịch sử đơn hàng cũ bên MS-04." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#bdbdbd;align=left;fontSize=11.5;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="110" y="560" width="1170" height="135" as="geometry"/></mxCell>
    <mxCell id="e_s_p" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="start" target="st_pending" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="e_p_a" value="Hoàn thiện Họ tên &amp;amp; SĐT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#2e7d32;strokeWidth=1.5;endArrow=block;endFill=1;;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="st_pending" target="st_active" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell>
    <mxCell id="e_a_s" value="Admin khóa (Vi phạm)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#d32f2f;strokeWidth=1.5;endArrow=block;endFill=1;;exitX=0.8;exitY=0;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" source="st_active" target="st_suspended" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="774" y="115"/><mxPoint x="1056" y="115"/></Array><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell>
    <mxCell id="e_s_a" value="Mở khóa (Review đạt)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#388e3c;strokeWidth=1.5;endArrow=block;endFill=1;;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=1;entryDx=0;entryDy=0;" edge="1" source="st_suspended" target="st_active" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1056" y="305"/><mxPoint x="774" y="305"/></Array><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell>
    <mxCell id="e_a_d" value="Yêu cầu xóa tài khoản (GDPR/NĐ13)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#455a64;strokeWidth=1.5;endArrow=block;endFill=1;;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="st_active" target="st_deleted" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="35" y="0" as="offset"/></mxGeometry></mxCell>
    <mxCell id="e_d_e" value="Kết thúc vòng đời" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#455a64;strokeWidth=1.5;endArrow=block;endFill=1;;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="st_deleted" target="end_term" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
  </root>
</mxGraphModel>
  </diagram>
  <diagram id="tab_4" name="4. Guest Claim FSM">
    <mxGraphModel dx="1530" dy="715" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1530" pageHeight="715" math="0" shadow="0">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="t4" value="&lt;b&gt;Sơ Đồ 4: Máy Trạng Thái Khôi Phục Đơn Hàng Vãng Lai (Guest Order Claim FSM)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=17;fontColor=#1a237e;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="20" width="850" height="35" as="geometry"/></mxCell>
    <mxCell id="start" value="" style="shape=ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="30" height="30" as="geometry"/></mxCell>
    <mxCell id="st_init" value="INITIATED&lt;br&gt;&lt;i&gt;Tạo yêu cầu claim đơn vãng lai&lt;br&gt;(OrderID + SĐT nhận kẹo)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontStyle=1;fontSize=12.5;" vertex="1" parent="1"><mxGeometry x="110" y="255" width="260" height="80" as="geometry"/></mxCell>
    <mxCell id="st_verified" value="OTP_VERIFIED&lt;br&gt;&lt;i&gt;Nhập đúng mã OTP SMS 6 số&lt;br&gt;(Trong vòng 15 phút)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#fbc02d;fontStyle=1;fontSize=12.5;" vertex="1" parent="1"><mxGeometry x="550" y="255" width="260" height="80" as="geometry"/></mxCell>
    <mxCell id="st_claimed" value="CLAIMED&lt;br&gt;&lt;i&gt;Gắn customer_id vào đơn hàng cũ&lt;br&gt;Phát Event cộng Mè Xửng Xu&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;fontStyle=1;fontSize=12.5;" vertex="1" parent="1"><mxGeometry x="1000" y="255" width="270" height="80" as="geometry"/></mxCell>
    <mxCell id="end_ok" value="" style="shape=ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1430" y="280" width="30" height="30" as="geometry"/></mxCell>
    <mxCell id="st_expired" value="EXPIRED&lt;br&gt;&lt;i&gt;Quá hạn 15:00 chưa xác thực OTP&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#f57c00;fontStyle=1;fontSize=12.5;" vertex="1" parent="1"><mxGeometry x="550" y="95" width="260" height="75" as="geometry"/></mxCell>
    <mxCell id="end_exp" value="" style="shape=ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="920" y="117" width="30" height="30" as="geometry"/></mxCell>
    <mxCell id="st_rejected" value="REJECTED&lt;br&gt;&lt;i&gt;Nhập sai OTP quá 5 lần (Brute-force)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcdd2;strokeColor=#d32f2f;fontStyle=1;fontSize=12.5;" vertex="1" parent="1"><mxGeometry x="550" y="420" width="260" height="75" as="geometry"/></mxCell>
    <mxCell id="end_rej" value="" style="shape=ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="920" y="442" width="30" height="30" as="geometry"/></mxCell>
    <mxCell id="b_claim_notes" value="&lt;b&gt;CƠ CHẾ PHÒNG THỦ &amp;amp; TÍNH NHẤT QUÁN TOÀN VẸN:&lt;/b&gt;&lt;br&gt;
• &lt;b&gt;Chống Chiếm Đoạt Đơn Hàng (Anti-Hijack)&lt;/b&gt;: Mã OTP SMS bắt buộc gửi về đúng số điện thoại giao hàng của đơn vãng lai.&lt;br&gt;
• &lt;b&gt;Chống Claim Trùng Lặp (Double Claim Protection)&lt;/b&gt;: Database ràng buộc bằng Partial Unique Index &lt;code&gt;idx_unique_claimed_order&lt;/code&gt;.&lt;br&gt;
• &lt;b&gt;Phát Sự Kiện Phân Tán (Outbox Pattern)&lt;/b&gt;: Khi trạng thái đạt &lt;code&gt;CLAIMED&lt;/code&gt;, ghi Outbox &lt;code&gt;GuestOrderClaimedEvent&lt;/code&gt; trong cùng DB Transaction.&lt;br&gt;
• &lt;b&gt;Tích Lũy Điểm Bù (Retroactive Loyalty Points)&lt;/b&gt;: MS-07 consume sự kiện từ Kafka để cộng bù Mè Xửng Xu cho khách hàng." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#bdbdbd;align=left;fontSize=11.5;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="110" y="545" width="1160" height="135" as="geometry"/></mxCell>
    <mxCell id="e_c_start" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="start" target="st_init" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
