    <mxCell id="t2" value="&lt;b&gt;Sơ Đồ 2: Mô Hình Dữ Liệu Quan Hệ (PostgreSQL 16 Schema ERD — profile_db)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=17;fontColor=#1a237e;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="12" width="950" height="35" as="geometry"/></mxCell>
    <mxCell id="tbl_cust" value="customer_profiles" style="swimlane;startSize=28;fillColor=#1565c0;strokeColor=#0d47a1;fontColor=#ffffff;fontStyle=1;fontSize=13.5;" vertex="1" parent="1"><mxGeometry x="50" y="60" width="320" height="250" as="geometry"/></mxCell>
    <mxCell id="f_cust" value="&lt;b&gt;PK id&lt;/b&gt; : UUID (v7)&lt;br&gt;&lt;b&gt;UK user_id&lt;/b&gt; : UUID (1-1 Identity)&lt;br&gt;full_name : VARCHAR(150)&lt;br&gt;phone_number : VARCHAR(20) [IDX]&lt;br&gt;email : VARCHAR(255) [IDX]&lt;br&gt;date_of_birth : DATE&lt;br&gt;gender : VARCHAR(10)&lt;br&gt;avatar_url : VARCHAR(500)&lt;br&gt;&lt;b&gt;preferences&lt;/b&gt; : JSONB [GIN]&lt;br&gt;status : VARCHAR(20) DEFAULT &apos;ACTIVE&apos;&lt;br&gt;&lt;b&gt;version&lt;/b&gt; : INT DEFAULT 1 (OCC CAS)&lt;br&gt;created_at : TIMESTAMPTZ&lt;br&gt;updated_at : TIMESTAMPTZ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" vertex="1" parent="tbl_cust"><mxGeometry x="0" y="28" width="320" height="222" as="geometry"/></mxCell>
    <mxCell id="tbl_addr" value="shipping_addresses" style="swimlane;startSize=28;fillColor=#2e7d32;strokeColor=#1b5e20;fontColor=#ffffff;fontStyle=1;fontSize=13.5;" vertex="1" parent="1"><mxGeometry x="480" y="60" width="350" height="300" as="geometry"/></mxCell>
    <mxCell id="f_addr" value="&lt;b&gt;PK id&lt;/b&gt; : UUID (v7)&lt;br&gt;&lt;b&gt;FK customer_id&lt;/b&gt; : UUID (v7) [IDX]&lt;br&gt;recipient_name : VARCHAR(150)&lt;br&gt;phone_number : VARCHAR(20)&lt;br&gt;street_address : VARCHAR(255)&lt;br&gt;&lt;b&gt;FK ward_code&lt;/b&gt; : VARCHAR(20) [IDX]&lt;br&gt;ward_name : VARCHAR(100)&lt;br&gt;&lt;b&gt;FK province_code&lt;/b&gt; : VARCHAR(20) [IDX]&lt;br&gt;province_name : VARCHAR(100)&lt;br&gt;latitude : NUMERIC(10, 7)&lt;br&gt;longitude : NUMERIC(10, 7)&lt;br&gt;label : VARCHAR(50) DEFAULT &apos;HOME&apos;&lt;br&gt;&lt;b&gt;is_default&lt;/b&gt; : BOOLEAN DEFAULT FALSE&lt;br&gt;&lt;b&gt;is_deleted&lt;/b&gt; : BOOLEAN DEFAULT FALSE&lt;br&gt;created_at : TIMESTAMPTZ&lt;br&gt;updated_at : TIMESTAMPTZ&lt;br&gt;&lt;i&gt;-- Partial Unique Index (duy nhất 1 default):&lt;/i&gt;&lt;br&gt;&lt;b&gt;idx_unique_customer_default_address&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;spacingLeft=8;spacingTop=6;" vertex="1" parent="tbl_addr"><mxGeometry x="0" y="28" width="350" height="272" as="geometry"/></mxCell>
    <mxCell id="tbl_admin" value="administrative_units" style="swimlane;startSize=28;fillColor=#e65100;strokeColor=#bf360c;fontColor=#ffffff;fontStyle=1;fontSize=13.5;" vertex="1" parent="1"><mxGeometry x="940" y="60" width="320" height="210" as="geometry"/></mxCell>
    <mxCell id="f_admin" value="&lt;b&gt;PK code&lt;/b&gt; : VARCHAR(20)&lt;br&gt;name : VARCHAR(100) [GIN trgm]&lt;br&gt;name_en : VARCHAR(100)&lt;br&gt;full_name : VARCHAR(150)&lt;br&gt;&lt;b&gt;FK parent_code&lt;/b&gt; : VARCHAR(20) [IDX]&lt;br&gt;level : VARCHAR(20) (&apos;PROVINCE&apos;,&apos;WARD&apos;)&lt;br&gt;created_at : TIMESTAMPTZ&lt;br&gt;&lt;i&gt;-- Chuẩn 2 cấp hành chính hậu 01/07/2025:&lt;br&gt;Tỉnh/TP TW ──► Xã/Phường&lt;br&gt;Bãi bỏ hoàn toàn cấp Quận/Huyện&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" vertex="1" parent="tbl_admin"><mxGeometry x="0" y="28" width="320" height="182" as="geometry"/></mxCell>
    <mxCell id="tbl_outbox" value="outbox_events" style="swimlane;startSize=28;fillColor=#6a1b9a;strokeColor=#4a148c;fontColor=#ffffff;fontStyle=1;fontSize=13.5;" vertex="1" parent="1"><mxGeometry x="1360" y="60" width="290" height="220" as="geometry"/></mxCell>
    <mxCell id="f_outbox" value="&lt;b&gt;PK id&lt;/b&gt; : UUID (v7)&lt;br&gt;aggregate_type : VARCHAR(50)&lt;br&gt;aggregate_id : VARCHAR(100)&lt;br&gt;event_type : VARCHAR(100)&lt;br&gt;&lt;b&gt;payload&lt;/b&gt; : JSONB&lt;br&gt;topic : VARCHAR(100)&lt;br&gt;created_at : TIMESTAMPTZ [IDX]&lt;br&gt;&lt;b&gt;published_at&lt;/b&gt; : TIMESTAMPTZ&lt;br&gt;&lt;i&gt;-- Polling Index (SKIP LOCKED):&lt;br&gt;idx_outbox_unpublished&lt;br&gt;WHERE published_at IS NULL&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" vertex="1" parent="tbl_outbox"><mxGeometry x="0" y="28" width="290" height="192" as="geometry"/></mxCell>
    <mxCell id="tbl_claim" value="guest_order_claims" style="swimlane;startSize=28;fillColor=#00838f;strokeColor=#006064;fontColor=#ffffff;fontStyle=1;fontSize=13.5;" vertex="1" parent="1"><mxGeometry x="50" y="400" width="320" height="240" as="geometry"/></mxCell>
    <mxCell id="f_claim" value="&lt;b&gt;PK id&lt;/b&gt; : UUID (v7)&lt;br&gt;order_id : UUID [UK khi CLAIMED]&lt;br&gt;&lt;b&gt;FK claimed_by_customer_id&lt;/b&gt; : UUID [IDX]&lt;br&gt;phone_number : VARCHAR(20) [IDX]&lt;br&gt;claim_status : VARCHAR(20) DEFAULT &apos;INITIATED&apos;&lt;br&gt;verification_code : VARCHAR(10) (OTP)&lt;br&gt;verified_at : TIMESTAMPTZ&lt;br&gt;expires_at : TIMESTAMPTZ (15m)&lt;br&gt;created_at : TIMESTAMPTZ&lt;br&gt;&lt;i&gt;-- Partial Unique Index chống claim trùng:&lt;br&gt;idx_unique_claimed_order&lt;br&gt;WHERE claim_status = &apos;CLAIMED&apos;&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" vertex="1" parent="tbl_claim"><mxGeometry x="0" y="28" width="320" height="212" as="geometry"/></mxCell>
    <mxCell id="tbl_emp" value="employee_profiles" style="swimlane;startSize=28;fillColor=#c2185b;strokeColor=#880e4f;fontColor=#ffffff;fontStyle=1;fontSize=13.5;" vertex="1" parent="1"><mxGeometry x="480" y="400" width="350" height="290" as="geometry"/></mxCell>
    <mxCell id="f_emp" value="&lt;b&gt;PK id&lt;/b&gt; : UUID (v7)&lt;br&gt;&lt;b&gt;UK user_id&lt;/b&gt; : UUID&lt;br&gt;&lt;b&gt;UK employee_code&lt;/b&gt; : VARCHAR(50) [IDX]&lt;br&gt;full_name : VARCHAR(150)&lt;br&gt;phone_number : VARCHAR(20)&lt;br&gt;&lt;b&gt;id_card_encrypted&lt;/b&gt; : BYTEA (CCCD Vault AES)&lt;br&gt;id_card_nonce : BYTEA (12-byte GCM Nonce)&lt;br&gt;&lt;b&gt;encrypted_dek&lt;/b&gt; : BYTEA (Encrypted by KEK)&lt;br&gt;kek_version : INT DEFAULT 1&lt;br&gt;&lt;b&gt;FK department_id&lt;/b&gt; : VARCHAR(50) [IDX]&lt;br&gt;position : VARCHAR(100)&lt;br&gt;contract_type : VARCHAR(20)&lt;br&gt;food_safety_cert_no : VARCHAR(100)&lt;br&gt;&lt;b&gt;food_safety_cert_expiry&lt;/b&gt; : DATE [IDX]&lt;br&gt;status : VARCHAR(20) DEFAULT &apos;ACTIVE&apos;&lt;br&gt;created_at : TIMESTAMPTZ&lt;br&gt;updated_at : TIMESTAMPTZ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;spacingLeft=8;spacingTop=6;" vertex="1" parent="tbl_emp"><mxGeometry x="0" y="28" width="350" height="262" as="geometry"/></mxCell>
    <mxCell id="tbl_dept" value="departments" style="swimlane;startSize=28;fillColor=#455a64;strokeColor=#263238;fontColor=#ffffff;fontStyle=1;fontSize=13.5;" vertex="1" parent="1"><mxGeometry x="940" y="400" width="320" height="200" as="geometry"/></mxCell>
    <mxCell id="f_dept" value="&lt;b&gt;PK id&lt;/b&gt; : VARCHAR(50) (e.g. DEPT-PROD-01)&lt;br&gt;name : VARCHAR(150)&lt;br&gt;description : TEXT&lt;br&gt;manager_id : UUID&lt;br&gt;created_at : TIMESTAMPTZ&lt;br&gt;updated_at : TIMESTAMPTZ&lt;br&gt;&lt;i&gt;-- Quản lý phòng ban xưởng kẹo:&lt;br&gt;Xưởng quấy kẹo, Tổ đóng gói OCOP,&lt;br&gt;Bộ phận kho vận &amp;amp; CSKH&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" vertex="1" parent="tbl_dept"><mxGeometry x="0" y="28" width="320" height="172" as="geometry"/></mxCell>
    <mxCell id="box_legend" value="&lt;b&gt;NGUYÊN TẮC THIẾT KẾ CSDL:&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Chuẩn hóa 3NF&lt;/b&gt; + Khóa chính UUID v7 đơn điệu theo thời gian.&lt;br&gt;• &lt;b&gt;Bảo mật PII:&lt;/b&gt; CCCD mã hóa Envelope AES-256 qua HashiCorp Vault.&lt;br&gt;• &lt;b&gt;OCC CAS:&lt;/b&gt; Kiểm soát tương tranh lạc quan qua trường &lt;code&gt;version&lt;/code&gt;.&lt;br&gt;• &lt;b&gt;Transactional Outbox:&lt;/b&gt; Đảm bảo tính nhất quán cuối cùng với Kafka." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#b0bec5;fontSize=11.5;align=left;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1360" y="400" width="290" height="200" as="geometry"/></mxCell>
    <mxCell id="rel_cust_addr" value="1-N sở hữu" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#1565c0;strokeWidth=1.5;endArrow=block;endFill=1;;exitX=1;exitY=0.38;exitDx=0;exitDy=0;entryX=0;entryY=0.31;entryDx=0;entryDy=0;" edge="1" source="tbl_cust" target="tbl_addr" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell>
    <mxCell id="rel_addr_admin" value="N-1 chuẩn 2 cấp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#e65100;strokeWidth=1.5;endArrow=block;endFill=1;;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.37;entryDx=0;entryDy=0;" edge="1" source="tbl_addr" target="tbl_admin" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell>
    <mxCell id="rel_admin_self" value="parent_code" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#e65100;strokeWidth=1.5;endArrow=block;endFill=1;;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=1;entryY=0.65;entryDx=0;entryDy=0;" edge="1" source="tbl_admin" target="tbl_admin" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1310" y="112"/><mxPoint x="1310" y="196"/></Array><mxPoint x="15" y="0" as="offset"/></mxGeometry></mxCell>
    <mxCell id="rel_cust_claim" value="1-N claim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#00838f;strokeWidth=1.5;endArrow=block;endFill=1;;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="tbl_cust" target="tbl_claim" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="0" as="offset"/></mxGeometry></mxCell>
    <mxCell id="rel_dept_emp" value="1-N trực thuộc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11.5;fontColor=#000000;fontStyle=1;strokeColor=#c2185b;strokeWidth=1.5;endArrow=block;endFill=1;;exitX=0;exitY=0.35;exitDx=0;exitDy=0;entryX=1;entryY=0.23;entryDx=0;entryDy=0;" edge="1" source="tbl_dept" target="tbl_emp" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell>
  </root>
</mxGraphModel>
