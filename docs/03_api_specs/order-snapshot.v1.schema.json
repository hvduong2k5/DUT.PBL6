{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.omama.example/order/snapshot/v1",
  "title": "OrderSnapshot v1 - review candidate",
  "description": "Immutable internal commercial payload at PLACE. Encrypted at rest; public views are separately redacted. Structural schema does not enforce arithmetic, digests, chronology or remote proof validity; see chapter 12 semantic rules. No status, receipt, refund, live task or secret fields. Promotions disabled for v1.",
  "$defs": {
    "CustomerOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "principal_id",
        "customer_id",
        "guest_session_id"
      ],
      "properties": {
        "kind": {
          "const": "CUSTOMER"
        },
        "principal_id": {
          "type": "string",
          "format": "uuid"
        },
        "customer_id": {
          "type": "string",
          "format": "uuid"
        },
        "guest_session_id": {
          "type": "null"
        }
      }
    },
    "GuestOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "principal_id",
        "customer_id",
        "guest_session_id"
      ],
      "properties": {
        "kind": {
          "const": "GUEST"
        },
        "principal_id": {
          "type": "string",
          "format": "uuid"
        },
        "customer_id": {
          "type": "null"
        },
        "guest_session_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "Owner": {
      "oneOf": [
        {
          "$ref": "#/$defs/CustomerOwner"
        },
        {
          "$ref": "#/$defs/GuestOwner"
        }
      ]
    },
    "Provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quote_id",
        "cart_id",
        "cart_revision",
        "selection_digest",
        "items_digest",
        "quote_hash",
        "accepted_at",
        "canonicalized_at"
      ],
      "properties": {
        "quote_id": {
          "type": "string",
          "format": "uuid"
        },
        "cart_id": {
          "type": "string",
          "format": "uuid"
        },
        "cart_revision": {
          "type": "integer",
          "minimum": 0
        },
        "selection_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "items_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "quote_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "accepted_at": {
          "type": "string",
          "format": "date-time"
        },
        "canonicalized_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "CatalogEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "version",
        "valid_until"
      ],
      "properties": {
        "snapshot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "valid_until": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "Packaging": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "unit_code",
        "packaging_version"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "unit_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "packaging_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      }
    },
    "Item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line_id",
        "sku_code",
        "product_name",
        "quantity",
        "unit_price",
        "line_subtotal",
        "weight_grams",
        "packaging",
        "catalog_version"
      ],
      "properties": {
        "line_id": {
          "type": "string",
          "format": "uuid"
        },
        "sku_code": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "product_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999
        },
        "unit_price": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000000
        },
        "line_subtotal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000000
        },
        "weight_grams": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        },
        "packaging": {
          "$ref": "#/$defs/Packaging"
        },
        "catalog_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      }
    },
    "AddressSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "profile_address_id",
        "address_version",
        "validation_reference"
      ],
      "properties": {
        "kind": {
          "enum": [
            "PROFILE_ADDRESS",
            "VALIDATED_INLINE"
          ]
        },
        "profile_address_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "address_version": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "validation_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "PROFILE_ADDRESS"
              }
            }
          },
          "then": {
            "properties": {
              "profile_address_id": {
                "type": "string",
                "format": "uuid"
              },
              "address_version": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "else": {
            "properties": {
              "profile_address_id": {
                "type": "null"
              },
              "address_version": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "Address": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipient_name",
        "phone_e164",
        "street",
        "province_code",
        "province_name",
        "ward_code",
        "ward_name",
        "postal_code",
        "source"
      ],
      "properties": {
        "recipient_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "phone_e164": {
          "type": "string",
          "pattern": "^\\+84[35789][0-9]{8}$"
        },
        "street": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "province_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "province_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "ward_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "ward_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "postal_code": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/AddressSource"
        }
      }
    },
    "Shipping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "carrier_code",
        "service_code",
        "quote_reference",
        "quote_version",
        "valid_until",
        "package_weight_grams",
        "quoted_fee"
      ],
      "properties": {
        "carrier_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "service_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "quote_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "quote_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "valid_until": {
          "type": "string",
          "format": "date-time"
        },
        "package_weight_grams": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        },
        "quoted_fee": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        }
      }
    },
    "Money": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "subtotal",
        "merchandise_discount",
        "shipping_fee",
        "shipping_discount",
        "final_amount"
      ],
      "properties": {
        "currency": {
          "const": "VND"
        },
        "subtotal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000000
        },
        "merchandise_discount": {
          "const": 0
        },
        "shipping_fee": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "shipping_discount": {
          "const": 0
        },
        "final_amount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000000
        }
      }
    },
    "VietqrTerms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "provider",
        "payment_expires_at",
        "receiver_profile_id",
        "receiver_profile_version",
        "cod_policy_reference",
        "collect_amount"
      ],
      "properties": {
        "method": {
          "const": "VIETQR"
        },
        "provider": {
          "const": "SEPAY"
        },
        "payment_expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "receiver_profile_id": {
          "type": "string",
          "format": "uuid"
        },
        "receiver_profile_version": {
          "type": "integer",
          "minimum": 1
        },
        "cod_policy_reference": {
          "type": "null"
        },
        "collect_amount": {
          "type": "null"
        }
      }
    },
    "CodTerms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "provider",
        "payment_expires_at",
        "receiver_profile_id",
        "receiver_profile_version",
        "cod_policy_reference",
        "collect_amount"
      ],
      "properties": {
        "method": {
          "const": "COD"
        },
        "provider": {
          "type": "null"
        },
        "payment_expires_at": {
          "type": "null"
        },
        "receiver_profile_id": {
          "type": "null"
        },
        "receiver_profile_version": {
          "type": "null"
        },
        "cod_policy_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "collect_amount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000000
        }
      }
    },
    "PaymentTerms": {
      "oneOf": [
        {
          "$ref": "#/$defs/VietqrTerms"
        },
        {
          "$ref": "#/$defs/CodTerms"
        }
      ]
    },
    "Policies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order_policy_version",
        "checkout_policy_version",
        "payment_policy_version",
        "shipping_policy_version",
        "promotion_policy_version"
      ],
      "properties": {
        "order_policy_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "checkout_policy_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "payment_policy_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "shipping_policy_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "promotion_policy_version": {
          "type": "null"
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_schema_version",
    "snapshot_id",
    "order_id",
    "operation_id",
    "merchant_id",
    "warehouse_id",
    "channel",
    "placed_at",
    "owner_at_placement",
    "provenance",
    "catalog",
    "items",
    "shipping_address",
    "shipping",
    "money",
    "payment_terms",
    "policies"
  ],
  "properties": {
    "snapshot_schema_version": {
      "const": "1.0"
    },
    "snapshot_id": {
      "type": "string",
      "format": "uuid"
    },
    "order_id": {
      "type": "string",
      "format": "uuid"
    },
    "operation_id": {
      "type": "string",
      "format": "uuid"
    },
    "merchant_id": {
      "type": "string",
      "format": "uuid"
    },
    "warehouse_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "channel": {
      "const": "D2C_WEB"
    },
    "placed_at": {
      "type": "string",
      "format": "date-time"
    },
    "owner_at_placement": {
      "$ref": "#/$defs/Owner"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "catalog": {
      "$ref": "#/$defs/CatalogEvidence"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/Item"
      }
    },
    "shipping_address": {
      "$ref": "#/$defs/Address"
    },
    "shipping": {
      "$ref": "#/$defs/Shipping"
    },
    "money": {
      "$ref": "#/$defs/Money"
    },
    "payment_terms": {
      "$ref": "#/$defs/PaymentTerms"
    },
    "policies": {
      "$ref": "#/$defs/Policies"
    }
  }
}
