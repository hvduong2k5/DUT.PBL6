ADMIN_API_UPSTREAM_URL=http://127.0.0.1:4030/api/v1

# Local Mockoon only. These are permission profiles, not application Roles.
# PACKING_MANAGEMENT and PACKING_WORKBENCH both return Role PACKING with different Permission/Scope projections.
# DELIVERY_WORKBENCH returns Role DELIVERY.
# WAREHOUSE_MANAGEMENT and WAREHOUSE_WORKBENCH both return Role WAREHOUSE with different Permission projections.
# WAREHOUSE_STAFF remains a legacy local profile; prefer the two WAREHOUSE_* profiles above.
# Supported profiles: SALES_MANAGER, CUSTOMER_SERVICE, VIEW_ONLY, WAREHOUSE_MANAGEMENT, WAREHOUSE_WORKBENCH, WAREHOUSE_STAFF, PACKING_MANAGEMENT, PACKING_WORKBENCH, DELIVERY_WORKBENCH, ACCOUNTANT, SYSTEM_ADMIN.
ADMIN_MOCK_PROFILE=SALES_MANAGER
