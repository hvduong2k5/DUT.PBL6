# Identity owner contract (PR #45). Web never stores Keycloak tokens.
WEB_AUTH_MODE=identity-bff
WEB_PUBLIC_URL=https://omama.vn
IDENTITY_UPSTREAM_URL=https://api.omama.vn/api/v1
CUSTOMER_CORE_UPSTREAM_URL=https://api.omama.vn/api/v1/customer-api
CUSTOMER_EXTENSIONS_UPSTREAM_URL=https://api.omama.vn/api/v1/customer-api
NEXT_PUBLIC_MVP_COD_ENABLED=false
NEXT_PUBLIC_MVP_VOUCHER_ENABLED=false
NEXT_PUBLIC_MVP_GUEST_ORDER_ENABLED=false
# For disposable loopback TEST only; production uses HTTPS.
WEB_OIDC_ALLOW_LOCAL_HTTP=false

# Exact origin of signed PUT URLs issued by Fulfillment. Bytes are streamed by
# the Web server; the browser receives neither this URL nor storage credentials.
FULFILLMENT_STORAGE_UPLOAD_ORIGIN=http://packing-storage:9000
# Only for a native Web process outside Docker, when the signed hostname is not
# reachable: connect here while preserving its signed Host header.
# FULFILLMENT_STORAGE_UPLOAD_CONNECT_ORIGIN=http://127.0.0.1:19000
