# Public API gateway and extension service used only by server-side BFF handlers.
NEXT_PUBLIC_API_URL=http://localhost:8016/api/v1
IDENTITY_UPSTREAM_URL=http://127.0.0.1:8016/api/v1
CUSTOMER_CORE_UPSTREAM_URL=http://127.0.0.1:4010/api/v1
CUSTOMER_EXTENSIONS_UPSTREAM_URL=http://127.0.0.1:4020/api/v1
ADMIN_API_UPSTREAM_URL=http://127.0.0.1:4030/api/v1

# Optional Supply pilot. Set the full server-side Analytics API prefix.
# ANALYTICS_ADMIN_UPSTREAM_URL=http://127.0.0.1:18011/api/v1/admin/analytics
# ANALYTICS_PILOT_WAREHOUSE=warehouse-hue

# Local Mockoon only. Set B2B to exercise the verified business-customer journey.
CUSTOMER_MOCK_ACTOR=REGISTERED

# Local employee-operation Mockoon only. This selects fixture data; it never
# grants access. Employee identity and effective permissions come from Identity.
ADMIN_MOCK_PROFILE=SALES_MANAGER

# Legacy Guest Order extension only. It is ignored while the Guest Order gate is false.
# Replace with a strong server-only secret before enabling that extension.
ORDER_GUEST_ACCESS_SECRET=replace-with-a-different-long-random-secret

# Public, non-secret configuration.
NEXT_PUBLIC_TERMS_VERSION=2026-09

# Capabilities not accepted for the first Web MVP runtime. Enable only after
# the matching backend providers, policy and acceptance evidence are ready.
NEXT_PUBLIC_MVP_COD_ENABLED=false
NEXT_PUBLIC_MVP_VOUCHER_ENABLED=false
NEXT_PUBLIC_MVP_GUEST_ORDER_ENABLED=false
