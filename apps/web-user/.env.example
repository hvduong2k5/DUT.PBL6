# Server-only URL used by the Next.js BFF route handler.
AUTH_UPSTREAM_URL=http://127.0.0.1:4010/api/v1
CUSTOMER_UPSTREAM_URL=http://127.0.0.1:4011/api/v1
CATALOG_UPSTREAM_URL=http://127.0.0.1:4012/api/v1
PRODUCT_DETAIL_UPSTREAM_URL=http://127.0.0.1:4013/api/v1
CART_UPSTREAM_URL=http://127.0.0.1:4014/api/v1
CHECKOUT_UPSTREAM_URL=http://127.0.0.1:4015/api/v1
PAYMENT_UPSTREAM_URL=http://127.0.0.1:4016/api/v1
ORDER_UPSTREAM_URL=http://127.0.0.1:4017/api/v1

# Server-only signing secret. Replace with a strong secret outside local development.
PAYMENT_ACCESS_SECRET=replace-with-a-long-random-secret

# Public, non-secret configuration.
NEXT_PUBLIC_TERMS_VERSION=2026-09
