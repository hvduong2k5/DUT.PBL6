# Public API gateway and extension service used only by server-side BFF handlers.
NEXT_PUBLIC_API_URL=http://localhost:8016/api/v1
IDENTITY_UPSTREAM_URL=http://127.0.0.1:8016/api/v1
CUSTOMER_CORE_UPSTREAM_URL=http://127.0.0.1:4010/api/v1
CUSTOMER_EXTENSIONS_UPSTREAM_URL=http://127.0.0.1:4020/api/v1
# Gateway root for the commerce routes (catalog, cart, checkout, orders,
# payments, returns) and identity's public endpoints. Optional: when unset
# it is derived from CUSTOMER_CORE_UPSTREAM_URL (see ADR-002).
# API_GATEWAY_UPSTREAM_URL=http://127.0.0.1:4010/api/v1
ADMIN_API_UPSTREAM_URL=http://127.0.0.1:4030/api/v1

# Optional Supply pilot. Set the full server-side Analytics API prefix.
# ANALYTICS_ADMIN_UPSTREAM_URL=http://127.0.0.1:18011/api/v1/admin/analytics
# ANALYTICS_PILOT_WAREHOUSE=warehouse-hue

# Local Mockoon only. Set B2B to exercise the verified business-customer journey.
CUSTOMER_MOCK_ACTOR=REGISTERED

# Local employee-operation Mockoon only. This selects fixture data; it never
# grants access. Employee identity and effective permissions come from Identity.
ADMIN_MOCK_PROFILE=SALES_MANAGER

# Legacy Guest Order extension only. It is ignored while the Guest Order gate is false.
# Replace with a strong server-only secret before enabling that extension.
ORDER_GUEST_ACCESS_SECRET=replace-with-a-different-long-random-secret

# Public, non-secret configuration.
NEXT_PUBLIC_TERMS_VERSION=2026-09

# Capabilities not accepted for the first Web MVP runtime. Enable only after
# the matching backend providers, policy and acceptance evidence are ready.
NEXT_PUBLIC_MVP_COD_ENABLED=false
NEXT_PUBLIC_MVP_VOUCHER_ENABLED=false
NEXT_PUBLIC_MVP_GUEST_ORDER_ENABLED=false
# F-53: required in identity-bff mode, direct gateway route without OIDC validation.
# This must end in /api/v1, not the identity-owned /customer-api proxy path.
# GUEST_ORDER_UPSTREAM_URL=http://api-gateway:8000/api/v1
# Optional header overwritten by a trusted ingress (never arbitrary client input).
# Configure Kong and Order's proxy trust chain consistently to preserve per-IP quotas.
# WEB_GUEST_CLIENT_IP_HEADER=cf-connecting-ip
GUEST_SESSION_ISSUANCE_ENABLED=false
GUEST_CART_MUTATION_ENABLED=false
GUEST_COD_CHECKOUT_ENABLED=false
GUEST_VIETQR_CHECKOUT_ENABLED=false
GUEST_CART_MERGE_ENABLED=false
TRACEABILITY_UPSTREAM_URL=

# AI shopping assistant (ai-agent-service). The flag only shows the chat
# widget; conversations, consent and feedback are proxied by the web BFF to
# the server-side upstream below.
NEXT_PUBLIC_AI_CHAT_ENABLED=false
# AI_AGENT_UPSTREAM_URL=http://127.0.0.1:8019

# Procurement workspace/BFF: disabled until IAM grants and upstream are configured.
ADMIN_PROCUREMENT_ENABLED=false
# OIDC mode only; ends in /api/v1. identity-bff uses IDENTITY_UPSTREAM_URL instead.
PROCUREMENT_ADMIN_UPSTREAM_URL=
# Explicit opt-in only for a trusted private network/local test upstream.
PROCUREMENT_ADMIN_ALLOW_INSECURE_HTTP=false
