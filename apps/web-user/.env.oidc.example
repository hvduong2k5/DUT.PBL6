# Copy to a private environment file; never commit the completed secret.
WEB_AUTH_MODE=oidc
WEB_PUBLIC_URL=https://omama.vn
WEB_OIDC_ISSUER=https://keycloak.omama.vn/realms/omama
WEB_OIDC_CLIENT_ID=frontend-web
WEB_OIDC_API_AUDIENCE=omama-api
# Generate a random value of at least 32 bytes, consistent across Web replicas.
WEB_OIDC_COOKIE_SECRET=
WEB_OIDC_ALLOW_LOCAL_HTTP=false
CUSTOMER_CORE_UPSTREAM_URL=http://127.0.0.1:8000/api/v1
CUSTOMER_EXTENSIONS_UPSTREAM_URL=http://127.0.0.1:8000/api/v1
NEXT_PUBLIC_TERMS_VERSION=2026-09
NEXT_PUBLIC_MVP_COD_ENABLED=false
NEXT_PUBLIC_MVP_VOUCHER_ENABLED=false
NEXT_PUBLIC_MVP_GUEST_ORDER_ENABLED=false
