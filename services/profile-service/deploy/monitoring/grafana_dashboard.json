      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum(rate(profile_http_request_duration_seconds_bucket[1m])) by (le, path))",
          "legendFormat": "P99 {{path}}"
        }
