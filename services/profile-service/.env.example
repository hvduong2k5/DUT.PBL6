# Server-side only. Set a unique secret; do not use this token in browser code.
PROFILE_INTERNAL_TOKEN=

# Kafka brokers (comma-separated) shared with the outbox publisher.
KAFKA_BROKERS=localhost:9092

# Identity lifecycle events consumed to provision customer profiles.
# Topic and consumer group for the identity.events.v1 stream.
IDENTITY_EVENTS_TOPIC=identity.events.v1
IDENTITY_CONSUMER_GROUP=profile-identity-sync
