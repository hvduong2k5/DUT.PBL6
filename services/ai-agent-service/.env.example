# ai-agent-service (MS-19) — example environment. Copy to .env for local runs.
# Never commit a real .env.

# Storage (own ai_db, PostgreSQL + pgvector)
AI_DATABASE_URL=postgresql://ai_agent:ai_agent@localhost:54329/ai_db

# LLM provider: fake (tests/dev default) | gemini (dev, needs key) | bedrock (production)
AI_LLM_PROVIDER=fake
AI_MODEL_ID=amazon.nova-pro-v1:0
# Gemini dev only:
GEMINI_API_KEY=
AI_GEMINI_MODEL=gemini-2.0-flash
# Bedrock production only (credentials come from the IAM user / instance role):
AWS_REGION=ap-southeast-1

# Embeddings: fake | gemini | titan (production, via Bedrock)
AI_EMBEDDING_PROVIDER=fake
AI_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# Business service base URLs (read-only adapters go through the Tool Gateway)
AI_CATALOG_BASE_URL=http://localhost:8005
AI_INVENTORY_BASE_URL=http://localhost:8001
AI_ORDER_BASE_URL=http://localhost:8004
AI_SHIPPING_BASE_URL=http://localhost:8012
AI_ANALYTICS_BASE_URL=http://localhost:8011
# AI_FIXTURES=1 serves adapters from in-repo fixture data (dev/tests).
AI_FIXTURES=1

# Customer JWT verification (Keycloak/Identity)
AI_JWT_ISSUER=
AI_JWT_AUDIENCE=
AI_JWKS_URL=

# Conversation retention (decided 2026-11-09)
AI_RETENTION_CUSTOMER_DAYS=30
AI_RETENTION_GUEST_DAYS=15
