AI_FIXTURES=0
AI_DATABASE_URL=postgresql://ai_agent:replace-me@postgres:5432/ai_db
AI_MIGRATIONS_DIR=/app/migrations/postgres
AI_AUTO_MIGRATE=1

AI_LLM_PROVIDER=bedrock
AI_MODEL_ID=amazon.nova-pro-v1:0
AI_EMBEDDING_PROVIDER=titan
AI_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
AI_EMBEDDING_DIM=1024
AWS_REGION=ap-southeast-2

AI_CATALOG_BASE_URL=http://catalog-service:8006
AI_ORDER_BASE_URL=http://order-service:8004
AI_SHIPPING_BASE_URL=http://shipping-service:8012
AI_ANALYTICS_BASE_URL=http://analytics-service:8011
AI_IDENTITY_BASE_URL=http://identity-service:8016

AI_JWT_ISSUER=https://auth.example/realms/omama
AI_JWT_AUDIENCE=omama-customer
AI_JWKS_URL=http://identity-service:8016/.well-known/jwks.json

# Mount a >=32-byte random credential at this path. Never put its value here.
AI_INTERNAL_TOKEN_FILE=/run/secrets/ai_internal_token
AI_GUEST_TOKEN_SECRET_FILE=/run/secrets/ai_guest_token_secret
AI_LLM_TIMEOUT_SECONDS=20
AI_CLEANUP_INTERVAL_SECONDS=3600
