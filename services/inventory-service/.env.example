PORT=8001
# Use hostnames reachable from the Inventory container.
DB_URL=postgres://inventory:replace-me@postgres:5432/om_inventory_db?sslmode=disable
REDIS_ADDR=redis:6379
REDIS_PASSWORD=replace-me
KAFKA_BROKERS=kafka:9092

# Terminal RPCs require TLS and separate credentials for authenticated peers.
INVENTORY_TERMINAL_ENABLED=false
INVENTORY_TLS_CERT=
INVENTORY_TLS_KEY=
INVENTORY_ORDER_TOKEN=
INVENTORY_CATALOG_TOKEN=
INVENTORY_FULFILLMENT_TOKEN_FILE=
INVENTORY_TRACEABILITY_TOKEN=

# Optional seed JOB only. Leave false in production. Server never reads it.
INVENTORY_SEED_DEMO=false
# Explicit consumer opt-in; enabled without valid maps/brokers fails startup.
INVENTORY_PROCUREMENT_ENABLED=false
INVENTORY_PROCUREMENT_WAREHOUSE_MAP=WH-HUE=00000000-0000-0000-0000-000000000001
# Existing Inventory quantities must already use this base unit. Never point KG
# receipts at a finished-good SKU counted in pieces.
INVENTORY_PROCUREMENT_UNIT_MAP=NGUYEN-LIEU-ME-TRANG-HUE=GRAM
# Private operations listener. Empty disables it; use a private bind on deploy.
INVENTORY_METRICS_ADDR=127.0.0.1:8011
