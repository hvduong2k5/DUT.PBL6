PORT=8001
# Use hostnames reachable from the Inventory container.
DB_URL=postgres://inventory:replace-me@postgres:5432/om_inventory_db?sslmode=disable
REDIS_ADDR=redis:6379
REDIS_PASSWORD=replace-me
KAFKA_BROKERS=kafka:9092

# Terminal RPCs require TLS and separate credentials for authenticated peers.
INVENTORY_TERMINAL_ENABLED=false
INVENTORY_TLS_CERT=
INVENTORY_TLS_KEY=
INVENTORY_ORDER_TOKEN=
INVENTORY_CATALOG_TOKEN=
INVENTORY_FULFILLMENT_TOKEN_FILE=
INVENTORY_TRACEABILITY_TOKEN=
