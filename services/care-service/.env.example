# Trusted gateway-to-service authentication. Never expose this value to a browser.
CARE_INTERNAL_TOKEN=

ENVIRONMENT=development
HTTP_PORT=8006
LOG_LEVEL=info
RATE_LIMIT_PER_SECOND=20
RATE_LIMIT_BURST=40
DATABASE_URL=postgres://care_user:care_password@localhost:5438/care_db?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_IDLE=5m

KAFKA_BROKERS=localhost:9092
KAFKA_CARE_TOPIC=care.events.v1
OUTBOX_POLL_INTERVAL=500ms
OUTBOX_BATCH_SIZE=50
SLA_ALERT_POLL_INTERVAL=30s
SLA_NEAR_BREACH_WINDOW=30m
SLA_ALERT_BATCH_SIZE=100

S3_ENDPOINT=localhost:9010
S3_PUBLIC_ENDPOINT=localhost:9010
S3_ACCESS_KEY=carelocaladmin
S3_SECRET_KEY=carelocaladminsecret
S3_BUCKET=care-private
S3_REGION=us-east-1
S3_USE_SSL=false
S3_AUTO_CREATE_BUCKET=true

MEDIA_UPLOAD_URL_TTL=15m
MEDIA_ACCESS_URL_TTL=10m
MEDIA_ORPHAN_TTL=24h
MEDIA_CLEANUP_POLL_INTERVAL=1m
MEDIA_CLEANUP_BATCH_SIZE=100
BUSINESS_METRICS_POLL_INTERVAL=30s
SCANNER_MODE=noop
TICKET_REOPEN_WINDOW=168h

# Optional. Leave empty to use the OpenTelemetry no-op exporter locally.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_SERVICE_NAME=care-service

