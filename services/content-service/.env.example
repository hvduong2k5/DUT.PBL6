HTTP_PORT=8010
DATABASE_URL=postgres://content_dev:local_content_only@localhost:15410/content_db?sslmode=disable
DB_MAX_CONNS=5
LOG_LEVEL=info
# Optional tuning (defaults shown): DB_MIN_CONNS=0 DB_CONN_LIFETIME=30m DB_CONNECT_TIMEOUT=3s
# HTTP_REQUEST_TIMEOUT=10s READINESS_TIMEOUT=1s SHUTDOWN_TIMEOUT=15s MAX_BODY_BYTES=1048576
# Container entrypoint: RUN_MIGRATIONS=true applies pending migrations before start.

# Staff API (admin). Without issuer + public key the admin API answers 401.
# The public key is a PEM file path; on Coolify set CONTENT_JWT_PUBLIC_KEY_B64 instead.
CONTENT_JWT_ISSUER=
CONTENT_JWT_PUBLIC_KEY=
CONTENT_STAFF_AUDIENCE=omama-api
