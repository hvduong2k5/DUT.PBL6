# Catalog Service — Application Config
# Copy file này thành .env và điền giá trị thực

# ── Server ────────────────────────────────────────────────
SERVER_PORT=8005
HTTP_PORT=8005
GRPC_PORT=9005

# ── PostgreSQL ────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=om_catalog_db
DB_USERNAME=postgres
DB_PASSWORD=postgrespassword

# ── Redis ─────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispassword
REDIS_TTL_SECONDS=3600

# ── Flyway ────────────────────────────────────────────────
FLYWAY_ENABLED=true

# ── Kafka consumer (Inventory stock projection) ───────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=catalog-stock-projection
INVENTORY_STOCK_TOPIC=inventory.stock-changed.v1
CATALOG_EVENTS_TOPIC=catalog.events.v1
CATALOG_OUTBOX_ENABLED=true
GRPC_CLIENT_IDENTITY_ADDRESS=static://localhost:8016

# ── Swagger ───────────────────────────────────────────────
SPRINGDOC_ENABLED=true

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=INFO

# Internal snapshot credential, same value as Order's ORDER_INTERNAL_TOKEN (>=32 chars).
CATALOG_INTERNAL_TOKEN=
# Required for Catalog admin; existing Identity Employee + ADMIN boundary.
IDENTITY_URL=http://identity-service:8016
# Optional live display stock; requires TLS, CA, server name and internal credential.
CATALOG_INVENTORY_TARGET=
CATALOG_INVENTORY_TOKEN_FILE=
CATALOG_INVENTORY_CA_FILE=
CATALOG_INVENTORY_SERVER_NAME=
