# Catalog Service — Application Config
# Copy file này thành .env và điền giá trị thực

# ── Server ────────────────────────────────────────────────
SERVER_PORT=8080
GRPC_PORT=8005

# ── PostgreSQL ────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=om_catalog_db
DB_USERNAME=postgres
DB_PASSWORD=postgrespassword

# ── Redis ─────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispassword
REDIS_TTL_SECONDS=3600

# ── Flyway ────────────────────────────────────────────────
FLYWAY_ENABLED=true

# ── gRPC Client (nếu catalog-service cần gọi service khác) ─
GRPC_CLIENT_INVENTORY_ADDRESS=static://localhost:8001
GRPC_CLIENT_IDENTITY_ADDRESS=static://localhost:8016

# ── Swagger ───────────────────────────────────────────────
SPRINGDOC_ENABLED=true

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=INFO
