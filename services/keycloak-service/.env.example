# =============================================================================
# Keycloak Service - Environment Variables Template
# Runtime environment variables for Coolify Application or local container run
# =============================================================================

# ── Keycloak Master Admin Credentials ───────────────────────────────────────────
# Super admin account for Keycloak master realm (Admin Console access)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_keycloak_admin_password

# ── PostgreSQL Database Connection (Runtime) ───────────────────────────────────
# Connect to your PostgreSQL instance (e.g. existing Coolify PostgreSQL resource)
KC_DB_URL=jdbc:postgresql://postgres-host:5432/keycloak_db
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=change_me_keycloak_db_password

# ── Domain & Reverse Proxy (Coolify / Traefik / Nginx) ─────────────────────────
# Public URL where Keycloak is accessible
KC_HOSTNAME=https://keycloak.omama.vn
# Required behind Traefik/Coolify reverse proxy
KC_PROXY_HEADERS=xforwarded
# Enable HTTP listener behind TLS reverse proxy
KC_HTTP_ENABLED=true
# Allow direct container-to-container backend calls using internal Docker hostname
KC_HOSTNAME_STRICT_BACKCHANNEL=false

# ── Pre-configured Build-time Options (Baked into image, DO NOT alter at runtime) ─
# - KC_DB=postgres
# - KC_HEALTH_ENABLED=true
# - KC_METRICS_ENABLED=true

# ── Optional Local Development Flags ───────────────────────────────────────────
# Set to false only for local development (http://localhost:8080)
# KC_HOSTNAME_STRICT=false
