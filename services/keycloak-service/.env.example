# ── Keycloak Service (Keycloak + dedicated PostgreSQL) ──────────────────────────
# Public port of Keycloak on the host (default 8080)
KEYCLOAK_PORT=8080

# Keycloak master realm super admin
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_keycloak_admin_password

# ── Dedicated PostgreSQL of Keycloak ───────────────────────────────────────────
KEYCLOAK_DB_NAME=keycloak_db
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change_me_keycloak_db_password

# ── Domain & Reverse Proxy (Coolify / Traefik) ─────────────────────────────────
KC_HOSTNAME=https://keycloak.omama.vn
KC_PROXY_HEADERS=xforwarded
