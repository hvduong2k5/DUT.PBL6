# ── Keycloak Service (Keycloak + dedicated PostgreSQL) ──────────────────────────
# Public port of Keycloak on the host (default 8080)
KEYCLOAK_PORT=8080

# Keycloak master realm super admin
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_keycloak_admin_password

# ── Dedicated PostgreSQL of Keycloak ───────────────────────────────────────────
KEYCLOAK_DB_NAME=keycloak_db
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change_me_keycloak_db_password

# ── Domain & Reverse Proxy (Coolify / Traefik) ─────────────────────────────────
KC_HOSTNAME=https://keycloak.omama.vn
KC_PROXY_HEADERS=xforwarded

# ── Realm Token Lifetimes (seconds) ────────────────────────────────────────────
# Access Token lifespan in Keycloak realm (seconds). Default 900s (15 minutes).
KEYCLOAK_REALM_ACCESS_TOKEN_LIFESPAN=900
# SSO Session idle timeout (seconds). Default 86400s (24 hours).
KEYCLOAK_REALM_SSO_SESSION_IDLE_SECONDS=86400
# SSO Session max lifespan (seconds). Default 2592000s (30 days).
KEYCLOAK_REALM_SSO_SESSION_MAX_SECONDS=2592000
# Revoke Refresh Token on use (true/false).
KEYCLOAK_REALM_REVOKE_REFRESH_TOKEN=true
# Refresh Token max reuse (0 = single use).
KEYCLOAK_REALM_REFRESH_TOKEN_MAX_REUSE=0
