# =============================================================================
# KONG API GATEWAY - ENVIRONMENT CONFIGURATION
# =============================================================================

# Image Kong OSS
KONG_IMAGE=kong/kong:3.9.3

# Cấu hình CSDL PostgreSQL trên Coolify
KONG_PG_HOST=postgres
KONG_PG_PORT=5432
KONG_PG_DATABASE=kong
KONG_PG_USER=kong
KONG_PG_PASSWORD=your_secure_password_here

# Domain dành cho Kong Manager GUI & Admin API
KONG_ADMIN_GUI_URL=https://kong-manager.omama.vn
KONG_ADMIN_GUI_API_URL=https://kong-admin.omama.vn

# Port ánh xạ ra ngoài máy chủ (nếu cần truy cập trực tiếp qua IP:Port)
KONG_PROXY_PORT=8000
KONG_PROXY_SSL_PORT=8443

# Mức độ log (debug, info, notice, warn, error, crit)
KONG_LOG_LEVEL=notice

