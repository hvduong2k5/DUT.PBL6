# ── Keycloak Standalone Environment Configuration ──────────────────────────────
# Cổng public của Keycloak (mặc định 8080)
KEYCLOAK_PORT=8080

# Tài khoản Admin tối cao của Keycloak (Master Realm)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ── Thông tin kết nối tới PostgreSQL Server có sẵn ─────────────────────────────
# Địa chỉ IP hoặc domain của máy chủ PostgreSQL có sẵn của bạn
POSTGRES_HOST=192.168.1.100
POSTGRES_PORT=5432

# Tên database dành riêng cho Keycloak (phải tạo trước trên PostgreSQL server)
KEYCLOAK_DB_NAME=keycloak_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password

# ── Domain / Hostname (Nếu chạy Reverse Proxy / Nginx / Production) ───────────
# KC_HOSTNAME=keycloak.omama.vn
# KC_PROXY_HEADERS=xforwarded
# KC_HTTP_ENABLED=true

