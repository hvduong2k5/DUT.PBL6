# ── Keycloak Standalone Production Configuration (Coolify) ──────────────────────
# Cổng public của Keycloak (khi cần mở trực tiếp trên host, mặc định 8080)
KEYCLOAK_PORT=8080

# Tài khoản Admin tối cao của Keycloak (Master Realm)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=your_super_secure_keycloak_password

# ── Kết nối PostgreSQL Database ────────────────────────────────────────────────
# Hostname của PostgreSQL trên Coolify (tên container nếu cùng network: postgres)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
KEYCLOAK_DB_NAME=keycloak_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password

# ── Cấu hình Domain & Traefik Reverse Proxy (Coolify) ───────────────────────────
KC_HOSTNAME=https://keycloak.omama.vn
KC_PROXY_HEADERS=xforwarded
KC_HTTP_ENABLED=true
KC_HOSTNAME_BACKCHANNEL_DYNAMIC=true
