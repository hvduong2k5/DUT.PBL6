{
  "id": "omama",
  "realm": "omama",
  "displayName": "Omama E-commerce",
  "enabled": true,
  "sslRequired": "external",
  "loginTheme": "omama",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "verifyEmail": false,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "vi",
    "en"
  ],
  "defaultLocale": "vi",
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 86400,
  "ssoSessionMaxLifespan": 2592000,
  "clients": [
    {
      "clientId": "frontend-web",
      "enabled": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "clientAuthenticatorType": "client-secret",
      "redirectUris": [
          "https://api.omama.vn/api/v1/public/auth/callback",
          "http://localhost:8016/api/v1/public/auth/callback",
          "http://127.0.0.1:8016/api/v1/public/auth/callback"
      ],
      "webOrigins": [
        "+"
      ],
      "publicClient": true,
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://omama.vn/api/auth/oidc/logged-out"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email",
        "audience-scope",
        "order-customer"
      ]
    },
    {
      "clientId": "identity-service-admin",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "serviceAccountsEnabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "realm-management-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "usermodel.clientRoleMapping.clientId": "realm-management",
            "claim.name": "resource_access.realm-management.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "audience-scope",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "audience-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "omama-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "order-customer",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "order-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "order-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "internal-principal-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "app_user_id",
            "claim.name": "user_id",
            "jsonType.label": "String",
            "multivalued": "false",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "order-customer-realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "user-permissions-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "permissions",
            "claim.name": "permissions",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@omama.vn",
      "firstName": "System",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": true
        }
      ],
      "realmRoles": [
        "ADMIN"
      ],
      "attributes": {
        "app_user_id": [
          "a0000000-0000-0000-0000-000000000001"
        ]
      }
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "CUSTOMER",
        "description": "Customer role"
      },
      {
        "name": "ADMIN",
        "description": "Administrator of Identity Service"
      }
    ]
  },
  "scopeMappings": [
    {
      "clientScope": "order-customer",
      "roles": [
        "CUSTOMER"
      ]
    }
  ]
}