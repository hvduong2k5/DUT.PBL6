<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hvduong.identity.infrastructure.persistence.mybatis.mapper.IdentityPrincipalMapper">

    <select id="findById" resultType="com.hvduong.identity.infrastructure.persistence.mybatis.mapper.IdentityPrincipalRow">
        SELECT *
        FROM identity_principals
        WHERE id = #{principalId}
    </select>

</mapper>
