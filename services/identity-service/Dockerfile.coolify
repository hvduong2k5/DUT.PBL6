# Multi-stage build for git-based deployments (Coolify).
# The default Dockerfile expects a prebuilt jar from a CI artifact flow;
# this one builds the jar from source so a plain git deploy works.
# Build context MUST be the repository root: the Gradle build reads
# ../../packages/proto relative to the service directory.
FROM gradle:9.2.0-jdk21 AS build
WORKDIR /build
COPY packages/proto ./packages/proto
COPY services/identity-service ./services/identity-service
WORKDIR /build/services/identity-service
RUN gradle bootJar -x test --no-daemon \
 && cp $(ls build/libs/*.jar | grep -v plain | head -1) /app.jar

FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
RUN addgroup -S appgroup && adduser -S appuser -G appgroup
COPY --from=build /app.jar app.jar
RUN chown -R appuser:appgroup /app
USER appuser
EXPOSE 8016 9016
ENV JAVA_OPTS="-XX:+UseG1GC -XX:MaxRAMPercentage=75.0"
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]
