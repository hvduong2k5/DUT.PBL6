# ── Identity Service Environment Configuration ────────────────────────────────
SERVER_PORT=8016
GRPC_SERVER_PORT=9016

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=identity_db
DB_USERNAME=postgres
DB_PASSWORD=12345678

# ── Keycloak Identity Provider ────────────────────────────────────────────────
KEYCLOAK_SERVER_URL=https://keycloak.omama.vn
KEYCLOAK_REALM=omama
KEYCLOAK_CLIENT_ID=identity-service-admin
KEYCLOAK_CLIENT_SECRET=changeme
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=https://keycloak.omama.vn/realms/omama
# Required to enable registration; random >=32 bytes, stable between replicas.
# Leave blank until supplied through deployment secrets.
IDENTITY_REGISTRATION_FINGERPRINT_KEY=

# ── Kafka ─────────────────────────────────────────────────────────────────────
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

