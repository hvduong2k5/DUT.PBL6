# ── Identity Service Production Configuration (Coolify) ────────────────────────
SERVER_PORT=8016
GRPC_SERVER_PORT=9016

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Hostname của PostgreSQL trên Coolify (tên container nếu cùng network: postgres)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=identity_db
DB_USERNAME=postgres
DB_PASSWORD=your_strong_postgres_password

# ── Keycloak Identity Provider ────────────────────────────────────────────────
# URL nội bộ trong mạng Docker để backend gọi Keycloak (token exchange, JWKS, admin api)
KEYCLOAK_SERVER_URL=http://omafood-keycloak-standalone:8080

# URL công khai ngoài Internet để trình duyệt người dùng truy cập trang login Keycloak
KEYCLOAK_PUBLIC_URL=https://keycloak.omama.vn

KEYCLOAK_REALM=omama
KEYCLOAK_CLIENT_ID=identity-service-admin
KEYCLOAK_CLIENT_SECRET=your_identity_service_admin_secret
KEYCLOAK_PUBLIC_CLIENT_ID=frontend-web
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=https://keycloak.omama.vn/realms/omama
# Required registration HMAC secret >=32 random bytes, stable between replicas.
IDENTITY_REGISTRATION_FINGERPRINT_KEY=

# URL callback sau khi đăng nhập thành công từ Keycloak
AUTH_REDIRECT_URI=https://api.omama.vn/api/v1/public/auth/callback

# URL gốc của Frontend Web (để redirect về sau khi đăng nhập hoặc khi có lỗi)
FRONTEND_BASE_URL=https://omama.vn

# ── BFF Session Cookie (Bảo mật HTTPS trên Production) ────────────────────────
COOKIE_SECURE=true
COOKIE_SAME_SITE=Lax
# Để trống nếu không chia sẻ subdomain, hoặc set .omama.vn để chia sẻ giữa api.omama.vn và omama.vn
COOKIE_DOMAIN=.omama.vn

# ── Kafka Broker (Mạng nội bộ Coolify) ─────────────────────────────────────────
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
