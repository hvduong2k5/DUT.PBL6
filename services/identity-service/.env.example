# ── Identity Service Environment Configuration ────────────────────────────────
SERVER_PORT=8016
GRPC_SERVER_PORT=9016

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=identity_db
DB_USERNAME=postgres
DB_PASSWORD=12345678

# ── Keycloak Identity Provider ────────────────────────────────────────────────
KEYCLOAK_SERVER_URL=http://keycloak:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_REALM=omama
KEYCLOAK_CLIENT_ID=identity-service-admin
KEYCLOAK_CLIENT_SECRET=changeme
KEYCLOAK_PUBLIC_CLIENT_ID=frontend-web
AUTH_REDIRECT_URI=https://api.omama.vn/api/v1/public/auth/callback

# ── BFF Session Cookie ────────────────────────────────────────────────────────
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
COOKIE_DOMAIN=

# ── Kafka ─────────────────────────────────────────────────────────────────────
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
