# Sandbox backend; readiness requires migrations, a restricted runtime role and explicit identity/source files.
APP_MODE=sandbox
HTTP_ADDR=127.0.0.1:8003
DATABASE_URL=postgres://traceability:change-me@127.0.0.1:15403/om_traceability_db?sslmode=disable
PUBLIC_WEB_BASE_URL=http://localhost:3000
SANDBOX_ISOLATED_CONTAINER=false
SHUTDOWN_TIMEOUT=10s
# Compose database-only startup uses this independent migrator credential.
TRACEABILITY_DB_PASSWORD=replace-with-a-local-random-secret
# Configure only after creating a restricted runtime role; never reuse the migrator.
TRACEABILITY_RUNTIME_DATABASE_URL=

# Required by the sandbox API; private signing keys never enter the API process.
SANDBOX_JWT_PUBLIC_KEY_FILE=.sandbox/public.pem
SANDBOX_FIXTURE_FILE=.sandbox/batches.json
VIDEO_ALLOWED_HOSTS=

# No log-only broker fallback: off keeps durable PENDING events.
OUTBOX_RELAY_ENABLED=false
KAFKA_BROKERS=127.0.0.1:19093
EXPIRY_WORKER_ENABLED=true
