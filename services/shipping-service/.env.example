SHIPPING_HTTP_ADDRESS=:8012
SHIPPING_GRPC_ADDRESS=:9012
SHIPPING_V2_ENABLED=true
# Pin this explicitly in live env; do not rely on code defaults during rollout.
# Enable TLS before connecting Order over a service network. Both files are required.
# SHIPPING_GRPC_TLS_CERT_FILE=/run/secrets/shipping-cert.pem
# SHIPPING_GRPC_TLS_KEY_FILE=/run/secrets/shipping-key.pem
SHIPPING_DATABASE_URL=postgres://shipping:shipping@localhost:5438/shipping_db?sslmode=disable
SHIPPING_ENV=local
SHIPPING_INTERNAL_TOKEN=shipping-local-development-secret
SHIPPING_OIDC_ISSUER=https://keycloak.omama.vn/realms/omama
# Example only: replace with the actual deployed realm issuer (must match JWT iss).
SHIPPING_OIDC_AUDIENCE=omama-api
# Optional; defaults to ${SHIPPING_OIDC_ISSUER}/protocol/openid-connect/certs
# SHIPPING_OIDC_JWKS_URL=https://keycloak.omama.vn/realms/omama/protocol/openid-connect/certs
SHIPPING_FAKE_WEBHOOK_SECRET=fake-carrier-webhook-secret
SHIPPING_KAFKA_BROKERS=localhost:9092
# Optional Shipping-owned packing handoff (F-41). Keep disabled for Order-owned handoff.
SHIPPING_FULFILLMENT_TOPIC=fulfillment.events.v1
SHIPPING_FULFILLMENT_GROUP=shipping-service-v1
SHIPPING_PACKING_V2_ENABLED=false
SHIPPING_FULFILLMENT_V2_TOPIC=fulfillment.events.v2
SHIPPING_FULFILLMENT_V2_GROUP=shipping-service-v2
# Enable only with ORDER_SHIPPING_OWNS_PACKING_HANDOFF=true on Order.
# SHIPPING_ORDER_GRPC_ENDPOINT=order.internal:9004
# SHIPPING_ORDER_INTERNAL_TOKEN=<same-as-ORDER_SHIPPING_CALLER_TOKEN>
SHIPPING_ORDER_CA_FILE=
SHIPPING_ORDER_SERVER_NAME=
SHIPPING_DEFAULT_CARRIER=FAKE
SHIPPING_DEFAULT_SERVICE=STANDARD
# Foundation only; keep disabled until employee assignment/workbench acceptance.
SHIPPING_INTERNAL_DELIVERY_ENABLED=false
SHIPPING_INTERNAL_ASSIGNMENTS_ENABLED=false
# Existing Identity origin (HTTPS; local loopback HTTP is allowed for tests).
SHIPPING_IDENTITY_BASE_URL=
# Explicit policy is required when enabled. Example only, not a production tariff:
# SHIPPING_INTERNAL_DELIVERY_FEE_VND=25000
# SHIPPING_INTERNAL_DELIVERY_ETA=24h
SHIPPING_OUTBOX_POLL_INTERVAL=1s
SHIPPING_SHUTDOWN_TIMEOUT=10s
SHIPPING_DATABASE_TIMEOUT=5s

# GHN staging adapter. Keep disabled until sandbox credentials are configured.
SHIPPING_GHN_ENABLED=false
SHIPPING_GHN_BASE_URL=https://dev-online-gateway.ghn.vn
SHIPPING_GHN_TOKEN=
SHIPPING_GHN_SHOP_ID=
SHIPPING_GHN_FROM_DISTRICT_ID=
SHIPPING_GHN_FROM_WARD_CODE=
SHIPPING_GHN_WEBHOOK_SECRET=
SHIPPING_GHN_REQUEST_TIMEOUT=10s
SHIPPING_GHN_RECONCILE_TIMEOUT=5s
SHIPPING_GHN_QUOTE_TTL=15m
