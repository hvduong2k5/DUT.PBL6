SHIPPING_HTTP_ADDRESS=:8012
SHIPPING_GRPC_ADDRESS=:9012
SHIPPING_V2_ENABLED=false
SHIPPING_DATABASE_URL=postgres://shipping:shipping@localhost:5438/shipping_db?sslmode=disable
SHIPPING_INTERNAL_TOKEN=shipping-local-development-secret
SHIPPING_FAKE_WEBHOOK_SECRET=fake-carrier-webhook-secret
SHIPPING_KAFKA_BROKERS=localhost:9092
SHIPPING_FULFILLMENT_TOPIC=fulfillment.events.v1
SHIPPING_FULFILLMENT_GROUP=shipping-service-v1
SHIPPING_PACKING_V2_ENABLED=false
SHIPPING_FULFILLMENT_V2_TOPIC=fulfillment.events.v2
SHIPPING_FULFILLMENT_V2_GROUP=shipping-service-v2
# Enable the PackingCompleted consumer once Order Service implements GetShippingSnapshot.
# SHIPPING_ORDER_GRPC_ENDPOINT=localhost:9004
# SHIPPING_ORDER_INTERNAL_TOKEN=order-local-development-secret
SHIPPING_DEFAULT_CARRIER=FAKE
SHIPPING_DEFAULT_SERVICE=STANDARD
SHIPPING_OUTBOX_POLL_INTERVAL=1s
SHIPPING_SHUTDOWN_TIMEOUT=10s
SHIPPING_DATABASE_TIMEOUT=5s

# GHN staging adapter. Keep disabled until sandbox credentials are configured.
SHIPPING_GHN_ENABLED=false
SHIPPING_GHN_BASE_URL=https://dev-online-gateway.ghn.vn
SHIPPING_GHN_TOKEN=
SHIPPING_GHN_SHOP_ID=
SHIPPING_GHN_FROM_DISTRICT_ID=
SHIPPING_GHN_FROM_WARD_CODE=
SHIPPING_GHN_WEBHOOK_SECRET=
SHIPPING_GHN_REQUEST_TIMEOUT=10s
SHIPPING_GHN_QUOTE_TTL=15m
