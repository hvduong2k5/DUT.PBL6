  "components": {
    "schemas": {
      "Command": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_event",
          "purpose",
          "audience",
          "recipient_ref",
          "locale",
          "context_ref"
        ],
        "properties": {
          "source_event": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "source",
              "type",
              "aggregate_id",
              "aggregate_version",
              "cohort"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "source": {
                "const": "order-service"
              },
              "type": {
                "const": "vn.omama.order.placed.v3"
              },
              "aggregate_id": {
                "type": "string",
                "format": "uuid"
              },
              "aggregate_version": {
                "type": "integer",
                "minimum": 1
              },
              "cohort": {
                "const": "order-core-1"
              }
            }
          },
          "purpose": {
            "const": "ORDER_CONFIRMATION"
          },
          "audience": {
            "const": "BUYER"
          },
          "recipient_ref": {
            "type": "string",
            "pattern": "^order:[0-9a-f-]{36}:buyer$"
          },
          "locale": {
            "const": "vi-VN"
          },
          "context_ref": {
            "type": "string",
            "pattern": "^[A-Za-z0-9:_./-]{1,256}$"
          }
        }
      }
    },
    "securitySchemes": {
      "localBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Loopback local adapter only; production identity gate open"
      }
    }
