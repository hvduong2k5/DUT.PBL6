# Documentation only: Go does not automatically load this file.
# Set process/container environment explicitly. All file contents stay outside Git.
SEPAY_ENABLED=false
SEPAY_CONNECTION_ID=
SEPAY_RECEIVER_ID=
SEPAY_MERCHANT_IDENTITY=
SEPAY_EGRESS_SCOPE=
SEPAY_BOOTSTRAP_AT=
SEPAY_API_TOKEN_FILE=
SEPAY_WEBHOOK_SECRET_FILE=
SEPAY_RECEIVER_FILE=
# Optional Inventory3.2 capability (legacy simulator is not compatible)
SEPAY_INVENTORY_GRPC=
# Optional authenticated Care and Finance/evidence authority base URLs
SEPAY_CARE_URL=
SEPAY_FINANCE_URL=
SEPAY_EVIDENCE_HOSTS=
# Optional Guest grant signing: PKCS8 PEM ECDSA P-256, never commit private key
SEPAY_GUEST_SIGNING_KEY_FILE=
SEPAY_GUEST_SIGNING_KEY_ID=
# Optional previous HMAC overlap, remove once expiry is reached
SEPAY_WEBHOOK_PREVIOUS_SECRET_FILE=
SEPAY_WEBHOOK_PREVIOUS_KEY_VERSION=
SEPAY_WEBHOOK_PREVIOUS_VALID_UNTIL=
