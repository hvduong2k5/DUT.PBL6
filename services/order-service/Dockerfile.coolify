# Git-based deployment variant (Coolify) of the repo Dockerfile.
# Identical build; the entrypoint differs in two ways:
#  1. In sandbox mode the payment simulator (cmd/simulator) must run
#     next to the API, and a Coolify application runs a single
#     command: with ORDER_SIMULATOR_ENABLED=true the entrypoint starts
#     order-simulator in the background and execs order-api.
#  2. It materializes order's file-based peer credentials (the tokens
#     order exchanges with fulfillment) from base64 environment
#     variables, because Coolify cannot mount files (W0 E3).
# Otherwise it behaves exactly like the repo image (CMD order-api).
FROM golang:1.22 AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /bin/order-api ./cmd/server && CGO_ENABLED=0 go build -o /bin/order-simulator ./cmd/simulator
FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata && addgroup -g 10001 app && adduser -D -u 10001 -G app app && mkdir -p /run/secrets && chown app:app /run/secrets
COPY --from=builder /bin/order-api /bin/order-simulator /usr/local/bin/
RUN printf '%s\n' '#!/bin/sh' \
  'if [ -n "$ORDER_FULFILLMENT_TOKEN_B64" ]; then printf %s "$ORDER_FULFILLMENT_TOKEN_B64" | base64 -d > /run/secrets/order-fulfillment-token.txt; fi' \
  'if [ -n "$ORDER_FULFILLMENT_CALLER_TOKEN_B64" ]; then printf %s "$ORDER_FULFILLMENT_CALLER_TOKEN_B64" | base64 -d > /run/secrets/order-fulfillment-caller-token.txt; fi' \
  'if [ -n "$ORDER_SHIPPING_TOKEN_B64" ]; then printf %s "$ORDER_SHIPPING_TOKEN_B64" | base64 -d > /run/secrets/order-shipping-token.txt; fi' \
  'export ORDER_FULFILLMENT_TOKEN_FILE=/run/secrets/order-fulfillment-token.txt ORDER_FULFILLMENT_CALLER_TOKEN_FILE=/run/secrets/order-fulfillment-caller-token.txt ORDER_SHIPPING_TOKEN_FILE=/run/secrets/order-shipping-token.txt' \
  'if [ "$ORDER_SIMULATOR_ENABLED" = "true" ]; then order-simulator & fi' \
  'exec order-api' > /usr/local/bin/entrypoint.sh && chmod +x /usr/local/bin/entrypoint.sh
USER app
EXPOSE 8004 9004 8100
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
