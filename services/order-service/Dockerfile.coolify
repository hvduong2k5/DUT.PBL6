# Git-based deployment variant (Coolify) of the repo Dockerfile.
# Identical build; the only difference is the entrypoint: in sandbox
# mode the payment simulator (cmd/simulator) must run next to the API,
# and a Coolify application runs a single command. When
# ORDER_SIMULATOR_ENABLED=true the entrypoint starts order-simulator
# in the background and execs order-api as PID 1; otherwise it behaves
# exactly like the repo image (CMD order-api).
FROM golang:1.22 AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /bin/order-api ./cmd/server && CGO_ENABLED=0 go build -o /bin/order-simulator ./cmd/simulator
FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata && addgroup -g 10001 app && adduser -D -u 10001 -G app app
COPY --from=builder /bin/order-api /bin/order-simulator /usr/local/bin/
RUN printf '#!/bin/sh\nif [ "$ORDER_SIMULATOR_ENABLED" = "true" ]; then\n  order-simulator &\nfi\nexec order-api\n' > /usr/local/bin/entrypoint.sh && chmod +x /usr/local/bin/entrypoint.sh
USER app
EXPOSE 8004 9004 8100
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
