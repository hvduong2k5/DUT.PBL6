# Synthetic local sandbox values; production adapters are intentionally unavailable.
APP_MODE=sandbox
ORDER_INTERNAL_TOKEN=order-sandbox-internal-token-2026
ORDER_JWT_SECRET=order-sandbox-jwt-signing-secret-2026
CALLBACK_SECRET=order-sandbox-callback-secret-2026
ORDER_ENCRYPTION_KEY=AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=
PAYMENT_RECEIVER=SYNTHETIC-RECEIVER
# Optional existing Profile adapter, with its separate server-side credential:
# PROFILE_URL=http://profile-service:8080
# PROFILE_INTERNAL_TOKEN=set-explicitly

# Optional Shipping v2 revision/event adapter (requires core checkout + Kafka).
# ORDER_SHIPPING_GRPC=shipping-service:9012
# ORDER_SHIPPING_TOKEN_FILE=/run/secrets/order-shipping-token
# ORDER_SHIPPING_CA_FILE=/run/secrets/shipping-ca.pem
# ORDER_SHIPPING_SERVER_NAME=shipping.internal
# Loopback TEST only; cannot be used for service hostnames/network IPs:
# ORDER_SHIPPING_ALLOW_LOCAL_INSECURE=true

# Verified Identity persona for Keycloak mode (required in that mode).
# IDENTITY_URL=https://identity.internal
# Real Catalog snapshot and Shipping v2 quotes; all values are server-side.
# ORDER_CATALOG_URL=http://catalog-service:8006
# CATALOG_INTERNAL_TOKEN must match ORDER_INTERNAL_TOKEN (at least 32 characters).
# ORDER_WAREHOUSE_ID=set-real-warehouse-id
# ORDER_QUOTE_CARRIER_CODE=set-configured-carrier
# ORDER_QUOTE_SERVICE_CODE=set-configured-service

# Optional real Fulfillment integration: explicit VIDEO_REQUIRED policy file.
# ORDER_FULFILLMENT_GRPC=fulfillment-service:9002
# ORDER_FULFILLMENT_TOKEN_FILE=/run/secrets/order-to-fulfillment
# ORDER_FULFILLMENT_CALLER_TOKEN_FILE=/run/secrets/fulfillment-to-order
# ORDER_PACKING_POLICY_FILE=/etc/order/packing-policy.json
# ORDER_FULFILLMENT_CA_FILE=/run/secrets/fulfillment-ca.pem
# ORDER_FULFILLMENT_SERVER_NAME=fulfillment.internal
# ORDER_GRPC_TLS_CERT=/run/secrets/order-server.pem
# ORDER_GRPC_TLS_KEY=/run/secrets/order-server-key.pem
# ORDER_FULFILLMENT_ALLOW_LOCAL_INSECURE=true # sandbox loopback fixture only
