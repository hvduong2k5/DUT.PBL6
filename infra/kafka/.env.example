# =========================================================================
# KAFKA SHARED CLUSTER CONFIGURATION (.env)
# =========================================================================

# 1. Cấu hình Kafka Broker Port
# Local dev: bind 0.0.0.0
# VPS / Production có Domain: đặt 127.0.0.1 để KHÔNG phơi broker ra Internet công cộng
KAFKA_EXTERNAL_BIND_IP=0.0.0.0
KAFKA_EXTERNAL_PORT=9094
KAFKA_EXTERNAL_HOST=localhost

# 2. Cấu hình bảo mật giao diện Kafka UI (Khi gán Domain trên Coolify)
# AUTH_TYPE: LOGIN_FORM (yêu cầu đăng nhập) hoặc DISABLED (tắt xác thực khi test local)
KAFKA_UI_AUTH_TYPE=LOGIN_FORM
KAFKA_UI_USERNAME=admin
KAFKA_UI_PASSWORD=OmamaSecretPass@2026
KAFKA_UI_PORT=8085

# 3. Cấu hình Docker Network
# A. Chạy local thông thường:
DOCKER_NETWORK_NAME=om-network
DOCKER_NETWORK_EXTERNAL=false

# B. Khi chạy trên Coolify (Bỏ comment 2 dòng dưới):
# DOCKER_NETWORK_NAME=coolify
# DOCKER_NETWORK_EXTERNAL=true

