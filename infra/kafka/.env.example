# =========================================================================
# KAFKA SHARED CLUSTER CONFIGURATION (.env)
# =========================================================================

# Port cho ứng dụng ngoài máy host kết nối (Local dev, IDE)
KAFKA_EXTERNAL_PORT=9094
KAFKA_EXTERNAL_HOST=localhost

# Port giao diện Kafka UI (Truy cập: http://localhost:8085)
KAFKA_UI_PORT=8085

# Cấu hình Docker Network
# 1. Chạy local thông thường:
DOCKER_NETWORK_NAME=om-network
DOCKER_NETWORK_EXTERNAL=false

# 2. Khi chạy trên Coolify (Bỏ comment 2 dòng dưới):
# DOCKER_NETWORK_NAME=coolify
# DOCKER_NETWORK_EXTERNAL=true

