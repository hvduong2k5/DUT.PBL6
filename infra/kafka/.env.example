# =============================================================================
# KAFKA CLUSTER - LOCAL DEVELOPMENT CONFIGURATION (.env)
# Môi trường: Local Development (Docker Desktop / Docker Engine)
# File compose tương ứng: docker-compose.dev.yml (hoặc docker-compose.yml)
# Đối với Production trên Coolify, xem file: .env.prod.example
# =============================================================================

# 1. Cấu hình Kafka Broker Port
# Mở cổng ra máy Host để ứng dụng ngoài IDE (IntelliJ, VS Code, Gradle) kết nối
KAFKA_EXTERNAL_PORT=9094
KAFKA_EXTERNAL_HOST=localhost

# 2. Cấu hình giao diện Kafka UI Local (Truy cập: http://localhost:8085)
# Mặc định DISABLED để dev thuận tiện, không cần gõ mật khẩu
KAFKA_UI_AUTH_TYPE=DISABLED
KAFKA_UI_USERNAME=admin
KAFKA_UI_PASSWORD=admin123
KAFKA_UI_PORT=8085

# 3. Cấu hình Docker Network Local
DOCKER_NETWORK_NAME=om-network
